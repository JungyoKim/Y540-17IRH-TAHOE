+             phase ? "after " : "before", id, pid, type, valid ? valid[0] : 0xffffu, valid ? valid[6] : 0xffffu, nvLo(vm),
+             vm ? nvLo(vm->fRmHandle) : 0u, vm ? vm->fBytes : 0ull, vm ? (int)vm->fLazy : -1, (vm && vm->fKva) ? 1 : 0);
+    }
