+static const char *const kFamOpName[8] = { "pageon", "pageon/3", "pageoff/3", "pageonIfNeeded", "pageoffIfNeeded",
+                                           "zeroVidMemory", "pageoff/4-family", "rebuildPagingBuffer" };
+void nvFamNote(IOAccelResource2 *res, int op, int phase)
+{
+    if (!res || op < 0 || op > 7) return;
+    volatile unsigned char *r = (volatile unsigned char *)res;
+    const unsigned type = r[0x14];
+    void *cache = (type == 0xc0) ? *(void *volatile *)(r + 0xe0) : nullptr;
+    void *surf = cache ? *(void *volatile *)((unsigned char *)cache + 0x10) : nullptr;
+    const unsigned id = surf ? _ZNK9IOSurface12getSurfaceIDEv(surf) : 0;
+    volatile unsigned short *valid = (type == 0xc0) ? *(unsigned short *volatile *)(r + 0x30) : nullptr;
+    NVVidMemory *vm = nvres_vidmem(res);
+    const int pid = proc_selfpid();
