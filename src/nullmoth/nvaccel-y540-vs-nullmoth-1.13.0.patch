     NVAccel *a = NVAccel::gAccel;
+    for (unsigned k = 0; k < 3; k++) {
+        if (e->buf[k].handle && a) {
+            const IOReturn rr = a->askFramebufferForVram(&e->buf[k], false);
+            if (rr != kIOReturnSuccess) NVDBLOG("head %u: release of buffer %u (%llu bytes) refused (0x%x)", head, k, e->buf[k].actualSize, (unsigned)rr);
+        }
+        nvSVZero(&e->buf[k], sizeof e->buf[k]);
+    }
+    e->w = e->h = e->pitch = e->nbuf = 0; e->fb = nullptr; e->shown = e->prev = -1; e->pending = false; e->broken = false;
+    e->flipFailRun = 0;
+}
+// home: back to the boot scanout (NVRMFB waits for that one); otherwise a no-wait pure flip to buffer k
+static bool nvAccelDbFlip(IOService *fb, const NVIopDb *e, int k, bool home, int *flipResult)
+{
+    struct NVRMFlipRequest f; nvSVZero(&f, sizeof f);
+    f.version = NVRM_FLIP_ABI_VERSION;
+    if (home) f.flags = 1u;
+    else {
+        f.flags = NVRM_FLIP_FLAG_NOWAIT; f.kapiMemory = e->buf[k].handle; f.allocationCookie = e->buf[k].allocationCookie;
+        f.width = e->w; f.height = e->h; f.pitch = e->pitch;
+    }
+    const OSSymbol *sym = OSSymbol::withCStringNoCopy("nvFlipToSurfacePure");
+    const IOReturn rr = sym ? fb->callPlatformFunction(sym, false, &f, nullptr, nullptr, nullptr) : kIOReturnNoMemory;
+    if (sym) sym->release();
+    if (flipResult) *flipResult = f.flipResult;
+    if (home) OSAddAtomic64(1, &gCntDbHome);
+    return rr == kIOReturnSuccess;
+}
+// sleeps (no lock held) until the head's last flip has latched; false if it has not after maxMs
+static bool nvAccelDbWaitLatch(IOService *fb, unsigned maxMs)
+{
+    const OSSymbol *sym = OSSymbol::withCStringNoCopy("nvFlipPending");
+    if (!sym) return true;
+    bool ok = false;
+    for (unsigned i = 0; i <= maxMs; i++) {
+        unsigned int pending = 1;
+        const IOReturn rr = fb->callPlatformFunction(sym, false, &pending, nullptr, nullptr, nullptr);
+        if (rr != kIOReturnSuccess) { ok = rr == kIOReturnUnsupported; break; }   // an older NVRMFB waited inside the flip
+        if (!pending) { ok = true; break; }
+        IOSleep(1);
+    }
+    sym->release();
+    return ok;
+}
+static inline unsigned nvL10rTo8(unsigned v)   // A2 R10 G10 B10, little endian: B in bits 0-9, G 10-19, R 20-29
+{
+    return 0xff000000u | (((v >> 22) & 0xffu) << 16) | (((v >> 12) & 0xffu) << 8) | ((v >> 2) & 0xffu);
+}
+static void nvAccelDbCopy(volatile unsigned int *dst, unsigned dpitch, const volatile unsigned int *src, unsigned spitch,
+                          unsigned w, unsigned h, bool l10r)
+{
+    const unsigned long spr = spitch / 4, dpr = dpitch / 4;
+    const bool wide = !(spitch & 7) && !(dpitch & 7) && !((uintptr_t)src & 7) && !((uintptr_t)dst & 7);
+    const unsigned pairs = wide ? w / 2 : 0;
+    // y540 fastcopy: the source is the surface's system-memory pages after the sync (cached, stable), so it is read as
+    // plain memory, four 64-bit words at a time, and only the BAR1 stores stay volatile. The volatile loads kept every
+    // pixel serialized: an l10r frame took 3.0 ms on the panel (2.7 GB/s) against 1.1 ms for a BGRA one.
+    // debug.nvaccel_dbuf_fastcopy=0 brings back the old loop.
+    if (wide && gDbFastCopy) {
+        for (unsigned y = 0; y < h; y++) {
+            const unsigned long long *sp2 = (const unsigned long long *)(uintptr_t)(src + (unsigned long)y * spr);
+            volatile unsigned long long *dp2 = (volatile unsigned long long *)(dst + (unsigned long)y * dpr);
+            unsigned x = 0;
+            if (l10r) {
+                for (; x + 4 <= pairs; x += 4) {
+                    const unsigned long long a = sp2[x], b = sp2[x + 1], c = sp2[x + 2], d = sp2[x + 3];
+                    const unsigned long long ra = (unsigned long long)nvL10rTo8((unsigned)a) | ((unsigned long long)nvL10rTo8((unsigned)(a >> 32)) << 32);
+                    const unsigned long long rb = (unsigned long long)nvL10rTo8((unsigned)b) | ((unsigned long long)nvL10rTo8((unsigned)(b >> 32)) << 32);
+                    const unsigned long long rc = (unsigned long long)nvL10rTo8((unsigned)c) | ((unsigned long long)nvL10rTo8((unsigned)(c >> 32)) << 32);
+                    const unsigned long long rd = (unsigned long long)nvL10rTo8((unsigned)d) | ((unsigned long long)nvL10rTo8((unsigned)(d >> 32)) << 32);
+                    dp2[x] = ra; dp2[x + 1] = rb; dp2[x + 2] = rc; dp2[x + 3] = rd;
+                }
+                for (; x < pairs; x++) { const unsigned long long a = sp2[x];
+                    dp2[x] = (unsigned long long)nvL10rTo8((unsigned)a) | ((unsigned long long)nvL10rTo8((unsigned)(a >> 32)) << 32); }
+                if (w & 1) dst[(unsigned long)y * dpr + w - 1] = nvL10rTo8(src[(unsigned long)y * spr + w - 1]);
+            } else {
+                for (; x + 4 <= pairs; x += 4) {
+                    const unsigned long long a = sp2[x], b = sp2[x + 1], c = sp2[x + 2], d = sp2[x + 3];
+                    dp2[x] = a; dp2[x + 1] = b; dp2[x + 2] = c; dp2[x + 3] = d;
+                }
+                for (; x < pairs; x++) dp2[x] = sp2[x];
+                if (w & 1) dst[(unsigned long)y * dpr + w - 1] = src[(unsigned long)y * spr + w - 1];
+            }
+        }
+        return;
+    }
+    for (unsigned y = 0; y < h; y++) {
+        const volatile unsigned int *sp = src + (unsigned long)y * spr;
+        volatile unsigned int *dp = dst + (unsigned long)y * dpr;
+        const volatile unsigned long long *sp2 = (const volatile unsigned long long *)sp;
+        volatile unsigned long long *dp2 = (volatile unsigned long long *)dp;
+        if (l10r) {
+            for (unsigned x = 0; x < pairs; x++) {
+                const unsigned long long v = sp2[x];
+                dp2[x] = (unsigned long long)nvL10rTo8((unsigned)v) | ((unsigned long long)nvL10rTo8((unsigned)(v >> 32)) << 32);
+            }
+            for (unsigned x = 2 * pairs; x < w; x++) dp[x] = nvL10rTo8(sp[x]);
+        } else {
+            for (unsigned x = 0; x < pairs; x++) dp2[x] = sp2[x];
+            for (unsigned x = 2 * pairs; x < w; x++) dp[x] = sp[x];
+        }
+    }
+}
+static void nvAccelDbLatch(NVIopDb *e, unsigned head, IOService *fb)
+{
+    if (!nvAccelDbWaitLatch(fb, 100)) {
+        OSAddAtomic64(1, &gCntDbLatchTimeout);
+        e->broken = true;
+        NVDBLOG("head %u: the flip to buffer %d did not latch within 100 ms -- no more flips on this head, copying in place", head, e->shown);
+    } else nvZcLatched(e);
+    e->pending = false;
+}
+// y540 boothold (debug.nvaccel_boothold): at boot the panel shows the boot logo (NVRM copies the console into NVRMFB's
+// scanout before the first modeset), but WindowServer's first frames are one colour (black) for about 1.4 s until the boot
+// progress screen draws its own logo - a black blink between two logos (webcam, 2026-10-15 17:07:55.9). Until the first
+// frame on head 0 that has content, one-colour frames stay off the panel (their transaction completes as usual) and the logo
+// stays. The frame with content goes through the copy path (its pixels were just synced to system memory for the check).
+// Once per boot, at most debug.nvaccel_boothold_ms after the first held frame; boot-arg -nvaccelnobh turns it off.
+// Returns 1: content (copy it), 0: one colour (skip it), -1: off or done (the usual path).
+static int nvBootHoldCheck(NVIopDb *e, IOSurface *s)
+{
+    static bool args;
+    if (!args) {
+        args = true;
+        char b[8] = { 0 };
+        if (PE_parse_boot_argn("-nvaccelnobh", b, sizeof b)) { gBootHold = 0; ALOG("boothold: off (-nvaccelnobh)"); return -1; }
+    }
+    if (gBootHold != 1) return -1;
+    if (!s || !e->src || !e->sw || !e->sh || e->sp < 4ull * e->sw) {
+        gBootHold = 0; ALOG("boothold: a frame without a system-memory view -- off"); return -1;
+    }
+    const uint64_t now = mach_absolute_time();
+    if (!gBootHoldT0) gBootHoldT0 = now;
+    uint64_t ns = 0; absolutetime_to_nanoseconds(now - gBootHoldT0, &ns);
+    const unsigned ms = (unsigned)(ns / 1000000);
+    NVSyncInfo si;
+    for (unsigned i = 0; i < 4; i++) {
+        nvSVZero(&si, sizeof si); si.code = -1;
+        nvAccelSurfScanoutSync(s, &si);
+        if (si.code != 1) break;                 // 1 = the accelerator lock was busy and the frame is still only in VRAM
+        IOSleep(1);
+    }
+    if (ms >= (unsigned)gBootHoldMaxMs) {
+        gBootHold = 0;
+        ALOG("boothold: no frame with content within %u ms (%d held) -- WindowServer's frames go to the panel", ms, gBootHoldHeld);
+        return -1;
+    }
+    if (si.code == 1) { gBootHoldHeld++; return 0; }   // not readable yet: keep the logo, look at the next frame
+    const unsigned mask = e->l10r ? 0x3fffffffu : 0x00ffffffu;
+    const volatile unsigned int *p = e->src; const unsigned long spr = e->sp / 4;
+    const unsigned first = p[0] & mask;
+    bool varied = false;
+    // the whole screen 16 x 16, then the middle half every 4 pixels (the boot logo is about 100 px wide at 1080p)
+    for (unsigned i = 0; i < 16 && !varied; i++)
+        for (unsigned j = 0; j < 16; j++) {
+            const unsigned long y = (unsigned long)e->sh * (2 * i + 1) / 32, x = (unsigned long)e->sw * (2 * j + 1) / 32;
+            if ((p[y * spr + x] & mask) != first) { varied = true; break; }
+        }
+    for (unsigned y = e->sh / 4; y < 3 * e->sh / 4 && !varied; y += 4)
+        for (unsigned x = e->sw / 4; x < 3 * e->sw / 4; x += 4)
+            if ((p[(unsigned long)y * spr + x] & mask) != first) { varied = true; break; }
+    if (varied) {
+        gBootHold = 0;
+        ALOG("boothold: surface 0x%x has content after %d one-colour frame(s) kept off the panel for %u ms -- on the panel now",
+             s->getSurfaceID(), gBootHoldHeld, ms);
+        return 1;
+    }
+    if (++gBootHoldHeld == 1)
+        ALOG("boothold: WindowServer's first frame on the external display (head 1) is one colour 0x%06x -- its boot logo stays until a frame has content (at most %d ms)",
+             first, gBootHoldMaxMs);
+    return 0;
+}
+static void nvAccelDbRun(void *p0, void *)
+{
+    NVIopDb *e = (NVIopDb *)p0;
+    const unsigned head = (unsigned)(e - gIopDb);
+    if (head < 2 && e->tEnter) {   // y540 dbpar: how long the frame waited for its worker to start
+        const SInt64 qd = (SInt64)((mach_absolute_time() - e->tEnter) / 1000);
+        OSAddAtomic64(qd, &gCntDbQdUs[head]); OSAddAtomic64(1, &gCntDbQdN[head]);
+        if (qd > gCntDbQdMaxUs[head]) gCntDbQdMaxUs[head] = qd;
+        if (qd > 2000) OSAddAtomic64(1, &gCntDbQdLate[head]);
+        e->tEnter = 0;
+    }
+  for (;;) {
+    IOSurface *s = e->s; NVDisplayPipe *pipe = e->pipe; IOService *fb = e->fb;
+    bool signaled = false;
+    // y540 zflip mode 1: a frame that goes to the panel straight from its own VRAM completes at the latch, so the surface
+    // it replaces is off the panel before WindowServer draws into it again
+    const bool zLate = e->zc && gZflip == 1;
+    if (gDbEarly && !zLate) {   // y540 dbearly: complete this frame's transaction now; the sync, copy and flip follow
+        __atomic_store_n(&e->curSignaled, 1, __ATOMIC_RELEASE);
+        _ZN18IOAccelDisplayPipe26signalTransactionInterruptEPv(pipe, nullptr);
+        signaled = true; OSAddAtomic64(1, &gCntDbEarly);
+    }
+    // y540 accbh2: the external display only (head 1). On the panel the black gap before the boot progress screen stays
+    // (it looked more natural to the user); an HDMI monitor needs 2-3 s to wake, so its boot logo must outlast that.
+    const int bh = (head == 1 && gBootHold == 1) ? nvBootHoldCheck(e, s) : -1;   // y540 boothold
+    const uint64_t tz0 = mach_absolute_time();
+    bool zdone = false;
+    if (bh < 0 && e->zc && gZflip && e->zMem && !e->broken) {
+        const unsigned sid = s->getSurfaceID();
+        nvSVInflightWait(sid, 100);                       // the frame's GPU work must be done before it is scanned out
+        const uint64_t tz1 = mach_absolute_time();
+        if (e->pending) nvAccelDbLatch(e, head, fb);      // NVKMS takes one flip at a time
+        const uint64_t tz2 = mach_absolute_time();
+        if (!e->broken) {
+            struct NVRMFlipRequest f; nvSVZero(&f, sizeof f);
+            f.version = NVRM_FLIP_ABI_VERSION; f.flags = NVRM_FLIP_FLAG_NOWAIT | (e->l10r ? NVRM_FLIP_FLAG_L10R : 0u);
+            f.kapiMemory = e->zMem; f.allocationCookie = e->zCookie; f.width = e->sw; f.height = e->sh; f.pitch = e->sp;
+            const OSSymbol *sym = OSSymbol::withCStringNoCopy("nvFlipToSurfacePure");
+            const IOReturn rr = sym ? fb->callPlatformFunction(sym, false, &f, nullptr, nullptr, nullptr) : kIOReturnNoMemory;
+            if (sym) sym->release();
+            const uint64_t tz3 = mach_absolute_time();
+            OSAddAtomic64((SInt64)((tz3 - tz2) / 1000), &gCntDbFlipUs);
+            if (rr == kIOReturnSuccess) {
+                e->prev = e->shown; e->shown = -2; e->pending = true; e->flipFailRun = 0; e->zRefuseRun = 0; gIopFlipped[head] = false;
+                nvZcShift(e, s);
+                const SInt64 n = OSAddAtomic64(1, &gCntZcFrames); OSAddAtomic64(1, &gCntDbFrames); OSAddAtomic64(1, &gCntDbFramesHead[head]);
+                if (n < 2 || n == 1000 || n == 100000)
+                    NVDBLOG("zflip frame #%lld (head %u): surface 0x%x %ux%u pitch %u scanned out of its own VRAM (%s)", (long long)n + 1,
+                            head, sid, e->sw, e->sh, e->sp, e->l10r ? "l10r as X2B10G10R10, R/B swapped by the CSC" : "BGRA");
+                zdone = true;
+                if (zLate) {
+                    nvAccelDbLatch(e, head, fb);
+                    OSAddAtomic64((SInt64)((mach_absolute_time() - tz3) / 1000), &gCntZcLatchUs);
+                }
+            } else {
+                OSAddAtomic64(1, &gCntZcRefused);
+                if (++e->zRefuseRun >= 3 && gZflip) {
+                    gZflip = 0;
+                    NVDBLOG("zflip: 3 direct flips refused in a row (flipResult %d) -- debug.nvaccel_zflip=0, frames are copied", f.flipResult);
+                } else NVDBLOG("zflip: direct flip of surface 0x%x refused (flipResult %d) -- this frame is copied", sid, f.flipResult);
+            }
+        }
+        const SInt64 gus = (SInt64)((tz1 - tz0) / 1000);
+        OSAddAtomic64(gus, &gCntZcGpuUs); if (gus > gCntZcGpuMaxUs) gCntZcGpuMaxUs = gus;
+        OSAddAtomic64((SInt64)((tz2 - tz1) / 1000), &gCntDbWaitUs);
+    }
+    if (!zdone && bh != 0) {
+    const uint64_t t0 = mach_absolute_time();
+    NVSyncInfo si;
+    for (unsigned i = 0; i < 4; i++) {
+        nvSVZero(&si, sizeof si); si.code = -1;
+        nvAccelSurfScanoutSync(s, &si);
+        if (si.code != 1) break;                 // 1 = the accelerator lock was busy and the frame is still only in VRAM
+        OSAddAtomic64(1, &gCntDbSyncRetry);
+        IOSleep(1);
+    }
+    const uint64_t t1 = mach_absolute_time();
+    // two buffers: while the last flip is pending, both are (or may be) on the panel, so wait for the latch before writing
+    if (e->pending && !e->broken && e->nbuf < 3) nvAccelDbLatch(e, head, fb);
+    const uint64_t t2 = mach_absolute_time();
+    int k = -1; volatile unsigned int *dst = nullptr; unsigned dpitch = e->pitch;
+    if (!e->broken) {
+        for (int i = 0; i < (int)e->nbuf; i++) if (i != e->shown && !(e->pending && i == e->prev)) { k = i; break; }
+        if (k >= 0) dst = (volatile unsigned int *)e->buf[k].kva;
+    } else if (e->shown >= 0) dst = (volatile unsigned int *)e->buf[e->shown].kva;
+    else { dst = e->bootKva; dpitch = e->bootPitch; }
+    if (dst && dpitch >= 4ull * e->sw) nvAccelDbCopy(dst, dpitch, e->src, e->sp, e->sw, e->sh, e->l10r);
+    const uint64_t t3 = mach_absolute_time();
+    // a flip may only be committed once the previous one latched (NVKMS refuses a second one in flight)
+    if (k >= 0 && e->pending) { nvAccelDbLatch(e, head, fb); if (e->broken) k = -1; }
+    const uint64_t t3b = mach_absolute_time();
+    if (k >= 0) {
+        int fr = 0;
+        if (nvAccelDbFlip(fb, e, k, false, &fr)) {
+            e->prev = e->shown; e->shown = k; e->pending = true; e->flipFailRun = 0; gIopFlipped[head] = false;
+            nvZcShift(e, nullptr);
+            const SInt64 n = OSAddAtomic64(1, &gCntDbFrames); OSAddAtomic64(1, &gCntDbFramesHead[head]);
+            if (n < 2 || n == 1000 || n == 100000)
+                NVDBLOG("frame #%lld (head %u) on buffer %d: %ux%u pitch %u from surface 0x%x (%s)", (long long)n + 1, head, k,
+                        e->w, e->h, e->pitch, s->getSurfaceID(), e->l10r ? "l10r narrowed" : "BGRA");
+        } else {
+            OSAddAtomic64(1, &gCntDbFlipFail);
+            NVDBLOG("head %u: flip to buffer %d REFUSED (flipResult %d) -- that frame stays off the panel", head, k, fr);
+            if (++e->flipFailRun >= 3) { e->broken = true; NVDBLOG("head %u: 3 refused flips in a row -- copying in place from now on", head); }
+        }
+    } else OSAddAtomic64(1, &gCntDbDirect);
+    const uint64_t t4 = mach_absolute_time();
+    const SInt64 copyUs = (SInt64)((t3 - t2) / 1000);
+    OSAddAtomic64((SInt64)((t2 - t1 + t3b - t3) / 1000), &gCntDbWaitUs); OSAddAtomic64((SInt64)((t1 - t0) / 1000), &gCntDbSyncUs);
+    OSAddAtomic64(copyUs, &gCntDbCopyUs); OSAddAtomic64((SInt64)((t4 - t3b) / 1000), &gCntDbFlipUs);
+    if (copyUs > gCntDbCopyMaxUs) gCntDbCopyMaxUs = copyUs;
+    }   // !zdone
+    if (zdone) {
+        const SInt64 tus = (SInt64)((mach_absolute_time() - tz0) / 1000);
+        OSAddAtomic64(tus, &gCntZcTxnUs); if (tus > gCntZcTxnMaxUs) gCntZcTxnMaxUs = tus;
+    }
+    e->s = nullptr; e->src = nullptr;
+    ((OSObject *)s)->release();
+    bool more = false;
+    IOSimpleLock *lk = nvDbPendLock();
+    if (lk) IOSimpleLockLock(lk);
+    if (__atomic_load_n(&e->hasPend, __ATOMIC_ACQUIRE)) {   // y540 dbearly: take the frame that waited in the slot
+        e->pipe = e->pPipe; e->s = e->pS; e->src = e->pSrc; e->sw = e->psw; e->sh = e->psh; e->sp = e->psp; e->l10r = e->pl10r;
+        e->bootKva = e->pBootKva; e->bootPitch = e->pBootPitch;
+        e->zc = e->pzc; e->zMem = e->pzMem; e->zCookie = e->pzCookie;
+        e->pPipe = nullptr; e->pS = nullptr; e->pSrc = nullptr;
+        __atomic_store_n(&e->curSignaled, 0, __ATOMIC_RELEASE);
+        __atomic_store_n(&e->hasPend, 0, __ATOMIC_RELEASE);
+        more = true;
+    } else __atomic_store_n(&e->busy, 0, __ATOMIC_RELEASE);
+    if (lk) IOSimpleLockUnlock(lk);
+    if (!signaled) _ZN18IOAccelDisplayPipe26signalTransactionInterruptEPv(pipe, nullptr);
+    ((OSObject *)pipe)->release();
+    if (!more) break;
+  }
+}
+static bool nvAccelDbAlloc(NVIopDb *e, IOService *fb, unsigned head, const struct NVRMVramRequest *q, unsigned nbuf)
+{
+    NVAccel *a = NVAccel::gAccel;
+    if (!a || e->allocFails >= 3) return false;
+    if (e->buf[0].handle || e->buf[1].handle || e->buf[2].handle) {
+        // a new geometry means NVRMFB set the mode again, which put its boot scanout back on the panel; make sure of it
+        if (e->shown != -1 && e->fb) { int fr = 0; nvAccelDbFlip(e->fb, e, 0, true, &fr); }
+        nvZcDropAll(e);
+        NVDBLOG("head %u: scanout %ux%u pitch %u, %u buffers wanted (had %u of %ux%u pitch %u) -- remaking them", head, q->width,
+                q->height, q->pitch, nbuf, e->nbuf, e->w, e->h, e->pitch);
+        nvAccelDbFree(e, head);
+    }
+    const unsigned long long bytes = (unsigned long long)q->pitch * q->height;
+    for (unsigned k = 0; k < nbuf; k++) {
+        struct NVRMVramRequest *r = &e->buf[k];
+        nvSVZero(r, sizeof *r);
+        r->version = NVRM_VRAM_ABI_VERSION; r->size = bytes;
+        const IOReturn rr = a->askFramebufferForVram(r, true);
+        if (rr != kIOReturnSuccess || !r->kva || !r->handle || r->actualSize < bytes) {
+            OSAddAtomic64(1, &gCntDbAllocFail); e->allocFails++;
+            NVDBLOG("head %u: VRAM for buffer %u (%llu bytes) refused (0x%x, kva %p) -- this head copies into the boot scanout",
+                    head, k, bytes, (unsigned)rr, r->kva);
+            if (rr != kIOReturnSuccess) nvSVZero(r, sizeof *r);
+            nvAccelDbFree(e, head);
+            return false;
+        }
+    }
+    e->fb = fb; e->w = q->width; e->h = q->height; e->pitch = q->pitch; e->nbuf = nbuf;
+    e->shown = e->prev = -1; e->pending = false; e->broken = false; e->flipFailRun = 0; e->allocFails = 0;
+    NVDBLOG("head %u: %u buffers of %ux%u pitch %u (%llu bytes each) at phys 0x%llx, 0x%llx, 0x%llx", head, nbuf, e->w, e->h,
+            e->pitch, e->buf[0].actualSize, e->buf[0].phys, e->buf[1].phys, e->buf[2].phys);
+    return true;
+}
+static bool nvAccelDbStart(NVDisplayPipe *pipe, IOService *fb, unsigned head, IOSurface *s, const volatile unsigned int *src,
+                           unsigned w, unsigned h, unsigned pitch, bool l10r, const struct NVRMVramRequest *q,
+                           bool zc, void *zMem, unsigned long long zCookie)
+{
+    if (head >= kNvMaxFB || !pipe || !fb || !s || !src || !q || !q->kva) return false;
+    NVIopDb *e = &gIopDb[head];
+    if (__atomic_load_n(&e->busy, __ATOMIC_ACQUIRE)) {
+        // y540 dbearly: the worker still has the previous frame (whose transaction already completed); this one waits in
+        // the slot and completes when the worker takes it. Same geometry only; anything else goes the old way.
