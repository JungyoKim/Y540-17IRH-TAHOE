+// ---- Y540 per-surface ledger -------------------------------------------------------------------------------------------
+#include <mach/mach_time.h>
+#include <sys/proc.h>
+struct NVSurfStat {
+    unsigned id, surf, incarn, lastMs;
+    unsigned sh, shFail, shPid, shMs, shVm, shRm, shBytes, shStatus;
+    unsigned dirty, dirtyRef, dirtyPid, dirtyFirstMs;
+    unsigned ceOk, ceFail, ceVm, ceRm, ceLastMs;
+    unsigned fam[8], famPid, famLastMs;
+    unsigned frames, blank, head, frFirstMs, frLastMs, frVm, w, h;
+};
+enum { kNVSS = 160 };
+static NVSurfStat gSS[kNVSS];
+static IOSimpleLock *volatile gSSLock;
+static SInt64 gCntFamOp[8];
+static inline unsigned nvSSNowMs(void) { return (unsigned)(mach_absolute_time() / 1000000ull); }
+static inline unsigned nvLo(const void *p) { return (unsigned)((uintptr_t)p & 0xffffffffu); }
+static IOSimpleLock *nvSSLock(void)
+{
+    if (!gSSLock) {
+        IOSimpleLock *l = IOSimpleLockAlloc();
+        if (l && !OSCompareAndSwapPtr(nullptr, l, (void *volatile *)&gSSLock)) IOSimpleLockFree(l);
+    }
+    return gSSLock;
+}
+// caller holds gSSLock; a different IOSurface object under a reused ID starts a new incarnation of the entry
+static NVSurfStat *nvSSGet(unsigned id, unsigned surfLo)
+{
+    if (!id) return nullptr;
+    int freeI = -1, oldI = 0; unsigned oldT = 0xffffffffu;
+    for (int i = 0; i < kNVSS; i++) {
+        NVSurfStat *e = &gSS[i];
+        if (e->id == id) {
+            if (surfLo && e->surf && e->surf != surfLo) {
+                const unsigned inc = e->incarn + 1;
+                for (unsigned k = 0; k < sizeof *e; k++) ((volatile unsigned char *)e)[k] = 0;
+                e->id = id; e->incarn = inc;
+            }
+            if (surfLo) e->surf = surfLo;
+            return e;
+        }
+        if (!e->id) { if (freeI < 0) freeI = i; }
+        else if (e->lastMs < oldT) { oldT = e->lastMs; oldI = i; }
+    }
+    NVSurfStat *e = &gSS[freeI >= 0 ? freeI : oldI];
+    for (unsigned k = 0; k < sizeof *e; k++) ((volatile unsigned char *)e)[k] = 0;
+    e->id = id; e->surf = surfLo;
+    return e;
+}
+#define NVSS_DO(id_, surf_, ...) do { IOSimpleLock *l_ = nvSSLock(); const unsigned now_ = nvSSNowMs(); (void)now_; \
+    if (l_) { IOSimpleLockLock(l_); NVSurfStat *e = nvSSGet((id_), nvLo(surf_)); if (e) { e->lastMs = now_; __VA_ARGS__; } IOSimpleLockUnlock(l_); } } while (0)
+
+static void nvSSFrame(IOSurface *s, unsigned head, bool blank, unsigned w, unsigned h, unsigned vmLo)
+{
+    NVSS_DO(_ZNK9IOSurface12getSurfaceIDEv((void *)s), s, {
+        if (!e->frames) e->frFirstMs = now_;
+        e->frames++; if (blank) e->blank++; e->head = head; e->frLastMs = now_; e->w = w; e->h = h;
+        if (vmLo) e->frVm = vmLo; });
+}
