+// ---- Y540 ws-async: GPU writes still in flight, per IOSurface ---------------------------------------------------------
+// WindowServer's compositor waited in commitAndWaitUntilSubmitted until the GPU had finished every command buffer that drew
+// into a screen-sized surface: about 4 ms of a 16 ms window-drag frame on its main thread, only so the display path would
+// never copy a half-drawn frame. With debug.nvaccel_ws_async the plugin marks such a surface here before it commits
+// (surface-dirty escape, plane | 0x80000000) and clears the mark once the GPU is done and the usual dirty mark is made
+// (plane | 0xC0000000). The display sync (nvAccelSurfScanoutSync) waits for the clear, holding no lock.
+#ifndef THREAD_UNINT
+#define THREAD_UNINT 0
+#endif
+#ifndef THREAD_TIMED_OUT
+#define THREAD_TIMED_OUT 1
+#endif
+enum { kNVSVInfl = 32 };
+static unsigned gNVSVInflId[kNVSVInfl];
+static uint64_t gNVSVInflSince[kNVSVInfl];
+static IOLock *volatile gNVSVInflLock;
+static IOLock *nvSVInflLock(void)
+{
+    if (!gNVSVInflLock) { IOLock *l = IOLockAlloc(); if (l && !OSCompareAndSwapPtr(nullptr, l, (void *volatile *)&gNVSVInflLock)) IOLockFree(l); }
+    return gNVSVInflLock;
+}
+static bool nvSVInflight(unsigned id, bool set)
+{
+    IOLock *l = id ? nvSVInflLock() : nullptr;
+    if (!l) return false;
+    bool ok = true;
+    IOLockLock(l);
+    int at = -1, freeSlot = -1;
+    for (int i = 0; i < kNVSVInfl; i++) {
+        if (gNVSVInflId[i] == id) { at = i; break; }
+        if (!gNVSVInflId[i] && freeSlot < 0) freeSlot = i;
+    }
+    if (set) {
+        const uint64_t now = mach_absolute_time();
+        if (at < 0) at = freeSlot;
+        if (at < 0)   // a mark older than a second belongs to a client that died before clearing it
+            for (int i = 0; i < kNVSVInfl; i++) if (now - gNVSVInflSince[i] > 1000000000ull) { at = i; break; }
+        if (at >= 0) { gNVSVInflId[at] = id; gNVSVInflSince[at] = now; OSAddAtomic64(1, &gCntInflSet); }
+        else { ok = false; OSAddAtomic64(1, &gCntInflFull); }
+    } else {
+        if (at >= 0) gNVSVInflId[at] = 0;
+        OSAddAtomic64(1, &gCntInflClear);
+        IOLockWakeup(l, (void *)gNVSVInflId, false);
+    }
+    IOLockUnlock(l);
+    return ok;
+}
+static void nvSVInflightWait(unsigned id, unsigned maxMs)
+{
+    IOLock *l = gNVSVInflLock;
+    if (!id || !l) return;
+    const uint64_t t0 = mach_absolute_time(), deadline = t0 + (uint64_t)maxMs * 1000000ull;   // x86: absolute time is ns
+    bool waited = false, timedOut = false;
+    IOLockLock(l);
+    for (;;) {
+        int at = -1;
+        for (int i = 0; i < kNVSVInfl; i++) if (gNVSVInflId[i] == id) { at = i; break; }
+        if (at < 0) break;
+        waited = true;
+        if (mach_absolute_time() >= deadline) { gNVSVInflId[at] = 0; timedOut = true; break; }
+        IOLockSleepDeadline(l, (void *)gNVSVInflId, deadline, THREAD_UNINT);
+    }
+    IOLockUnlock(l);
+    if (!waited) return;
+    const SInt64 us = (SInt64)((mach_absolute_time() - t0) / 1000);
+    OSAddAtomic64(1, &gCntInflWaits); OSAddAtomic64(us, &gCntInflWaitUs);
+    if (us > gCntInflWaitMaxUs) gCntInflWaitMaxUs = us;
+    if (timedOut) {
+        const SInt64 n = OSAddAtomic64(1, &gCntInflTimeouts) + 1;
+        if (n <= 8 || (n & 1023) == 0) ALOG("ws-async: surface %u still had a GPU write in flight after %u ms -- syncing anyway (%lld so far)", id, maxMs, (long long)n);
+    }
+}
