+        NvrmKmsSetDpyAttr p; bzero(&p, sizeof p);
+        p.dev = hDev; p.disp = hDisp; p.dpy = dpy; p.attr = attr; p.value = *value;
+        return fn(popen, kKmsIoctlSetDpyAttr, &p, sizeof p) ? 0 : EIO;
+    }
+    NvrmKmsGetDpyAttr p; bzero(&p, sizeof p);
+    p.dev = hDev; p.disp = hDisp; p.dpy = dpy; p.attr = attr;
+    if (!fn(popen, kKmsIoctlGetDpyAttr, &p, sizeof p)) return EIO;
