+        int wr = THREAD_AWAKENED;
+        while (OSAddAtomic(0, &gPmBlocked) && wr == THREAD_AWAKENED)
+            wr = IOLockSleepDeadline(gPmWaitLock, (void *)&gPmBlocked, dl, THREAD_UNINT);
+        IOLockUnlock(gPmWaitLock);
+        if (OSAddAtomic(0, &gPmBlocked)) return false;
+    }
