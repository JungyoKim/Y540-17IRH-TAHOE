+// Y540 (256 MB BAR1, dGPU-only laptop): nvfbbudget=<MB> overrides the surface budget, clamped so the scanouts
+// (gScanoutBytes) plus a 24 MB margin for the console and NVKMS always stay inside BAR1. Without it: upstream value.
+static volatile SInt64 gScanoutBytes = 0;
+static inline uint64_t nvrmY540Budget(uint64_t barLen)
+{
+    uint64_t b = barLen >= (4ull << 30) ? barLen / 2 : NVRM_VRAM_BAR1_BUDGET;
+    uint32_t mb = 0;
+    if (barLen && PE_parse_boot_argn("nvfbbudget", &mb, sizeof mb) && mb) {
+        const uint64_t reserve = (uint64_t)(gScanoutBytes > 0 ? gScanoutBytes : 0) + (24ull << 20);
+        const uint64_t ceiling = barLen > reserve ? barLen - reserve : 0;
+        const uint64_t want = (uint64_t)mb << 20;
+        b = want < ceiling ? want : ceiling;
+    }
+    return b;
+}
