+    if (!n || !n->init()) { if (n) n->release(); IOLog("NVRMFB: backlight nub alloc failed\n"); return; }
+    n->setName("backlight");
+    n->setProperty("NVRMBacklightNub", true);
+    if (!n->attach(parent)) { n->release(); IOLog("NVRMFB: backlight nub attach failed\n"); return; }
+    n->registerService(kIOServiceSynchronous);
+    gBacklightNub = n;
+    IOLog("NVRMFB: backlight nub published - the internal panel can attach as AppleBacklightDisplay\n");
