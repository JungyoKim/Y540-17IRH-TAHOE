+static int nvrmDpyAttrIoctl(NvU32 dpy, NvU32 attr, bool set, NvS64 *value)
+{
+    struct NvKmsKapiDevice *d = gDev;
+    if (!gNvrmSlideOk || !d || !dpy) return ENODEV;
+    typedef NvBool (*ioctl_t)(void *, NvU32, void *, size_t);
+    ioctl_t fn = (ioctl_t)(gNvrmSlideOk + kOffKmsIoctlFromKapi);
+    void *popen = *(void **)((uint8_t *)d + 0x38);
+    const NvU32 hDev = *(NvU32 *)((uint8_t *)d + 0x40), hDisp = *(NvU32 *)((uint8_t *)d + 0x44);
+    if (!popen || !hDev || !hDisp) return ENODEV;
