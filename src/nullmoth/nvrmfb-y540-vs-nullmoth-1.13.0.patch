+static bool nvrmPmResume(const char *why)
+{
+    const SInt32 state = OSAddAtomic(0, &gPmState);
+    if (!gPm.ok || state == kPmRunning) return false;
+    const uint64_t t0 = mach_absolute_time();
+    gPmThread = current_thread();
+    void *nv = gPm.gpuState();
+    uint8_t *nvp = nv ? *(uint8_t **)nv : nullptr;
+    uint8_t *gpu = nvp ? *(uint8_t **)nvp : nullptr;
