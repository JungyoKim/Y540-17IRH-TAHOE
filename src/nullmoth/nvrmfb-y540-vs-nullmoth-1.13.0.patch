+    NvU32 dpy = 0;
+    IORecursiveLock *sl = startLock();
+    if (sl) IORecursiveLockLock(sl);
+    for (int k = 0; k < 8 && !dpy; k++) if (gFBs[k] && gFBs[k]->internalPanel()) dpy = (NvU32)gFBs[k]->displayHandle();
+    if (sl) IORecursiveLockUnlock(sl);
+    return dpy;
+}
+static int nvrmfb_backlight_sysctl SYSCTL_HANDLER_ARGS
+{
+    NvS64 cur = -1; int v = -1;
+    const NvU32 dpy = nvrmInternalDpy();
+    if (dpy && nvrmBacklightIoctl(dpy, false, &cur) == 0) v = (int)cur;
+    int err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || req->newptr == 0) return err;
+    if (v < 0) v = 0; if (v > 100) v = 100;
+    NvS64 nv = v;
+    const int r = dpy ? nvrmBacklightIoctl(dpy, true, &nv) : ENODEV;
+    IOLog("NVRMFB: backlight set %d -> %d\n", v, r);
+    return r;
+}
+static int nvrmfb_dpyattr_sysctl SYSCTL_HANDLER_ARGS
+{
+    int v = -1; int err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || req->newptr == 0) return err;
+    const NvU32 dpy = nvrmInternalDpy(); NvS64 val = -1;
+    const int r = dpy ? nvrmDpyAttrIoctl(dpy, (NvU32)v, false, &val) : ENODEV;
+    IOLog("NVRMFB: dpyattr %d on dpy 0x%x (slide %d, dev %p) -> %d value %lld\n", v, dpy, gNvrmSlideOk != 0, gDev, r, (long long)val);
+    return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, nvrmfb_dpyattr_probe, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, nvrmfb_dpyattr_sysctl, "I",
+            "y540 fbbl11: write an NVKMS dpy attribute number; the kernel log shows what NVKMS returned for the internal panel");
+SYSCTL_PROC(_debug, OID_AUTO, nvrmfb_backlight, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, nvrmfb_backlight_sysctl, "I",
+            "y540 fbbl11: internal panel backlight 0-100 through NVKMS (-1: unavailable)");
+
+static thread_call_t gRelinkCall = nullptr;
+static void nvrmRelinkFire(thread_call_param_t, thread_call_param_t)
+{
+    NVRMNVDAFramebuffer *fb = nullptr;
+    IORecursiveLock *sl = startLock();
+    if (sl) IORecursiveLockLock(sl);
+    for (int k = 0; k < 8 && !fb; k++) if (gFBs[k] && gFBs[k]->internalPanel()) fb = gFBs[k];
+    if (fb) fb->retain();
+    if (sl) IORecursiveLockUnlock(sl);
+    if (!fb) { PMLOG("relink: no internal panel framebuffer"); return; }
+    fb->relinkPanel("sysctl");
+    fb->release();
+}
+static int nvrmfb_relink_sysctl SYSCTL_HANDLER_ARGS
+{
+    int v = 0; int err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || req->newptr == 0) return err;
+    if (!gRelinkCall) return ENODEV;
+    thread_call_enter(gRelinkCall);
+    return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, nvrmfb_relink, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, nvrmfb_relink_sysctl, "I",
+            "y540: switch the internal panel's head off and modeset it again (brings back a dark eDP panel)");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_relink_on_wake, CTLFLAG_RW | CTLFLAG_LOCKED, &gRelinkOnWake, 0,
+           "y540: re-link the internal panel on every display wake after a display-only sleep");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_relink_gap_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &gRelinkGapMs, 0,
+           "y540: milliseconds the head stays off during a relink");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_panel_off, CTLFLAG_RW | CTLFLAG_LOCKED, &gPanelOffOnSleep, 0,
+           "y540: switch the internal panel's head off while the display sleeps");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_clamshell, CTLFLAG_RW | CTLFLAG_LOCKED, &gClamshellOffline, 0,
+           "y540 fbbl10: 1 = with the lid closed and an external display connected the internal panel goes offline (as on a Mac)");
+// y540 fbgm1 gamma -> output LUT
+static int gGammaCalls = 0, gGammaCommits = 0, gGammaFails = 0;
+static int nvrmfb_gamma_sysctl SYSCTL_HANDLER_ARGS
+{
+    int v = gGammaOn; int err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || req->newptr == 0) return err;
+    gGammaOn = v ? 1 : 0;
+    if (!gGammaOn) {   // fbgm5: every head, not just fb0 (the external one is the one Tahoe sends tables to)
+        NVRMNVDAFramebuffer *fbs[8]; int nf = 0;
+        IORecursiveLock *sl = startLock(); if (sl) IORecursiveLockLock(sl);
+        for (int k = 0; k < 8; k++) if (gFBs[k]) { gFBs[k]->retain(); fbs[nf++] = gFBs[k]; }
+        if (sl) IORecursiveLockUnlock(sl);
+        for (int i = 0; i < nf; i++) { fbs[i]->lutForceOff("sysctl debug.nvrmfb_gamma=0"); fbs[i]->release(); }
+    }
+    return 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, nvrmfb_gamma, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, nvrmfb_gamma_sysctl, "I",
+            "y540 fbgm1: 1 = macOS gamma tables go to the head's output LUT (fades, Night Shift); 0 = ignored, LUT off");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_gamma_calls, CTLFLAG_RD | CTLFLAG_LOCKED, &gGammaCalls, 0, "y540 fbgm1: gamma tables received");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_gamma_lut_on, CTLFLAG_RD | CTLFLAG_LOCKED, &gGammaLutOn, 0, "y540 fbgm5: bitmask of framebuffers whose output LUT is on");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_gamma_commits, CTLFLAG_RD | CTLFLAG_LOCKED, &gGammaCommits, 0, "y540 fbgm1: LUT-only commits");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_gamma_fails, CTLFLAG_RD | CTLFLAG_LOCKED, &gGammaFails, 0, "y540 fbgm1: LUT-only commits refused");
+IOReturn NVRMNVDAFramebuffer::gammaSet(UInt32 channelCount, UInt32 dataCount, UInt32 dataWidth, void *data)
+{
+    OSIncrementAtomic(&gGammaCalls); fGammaCalls++;
+    if (!fRamps || !fRampsNext) return kIOReturnSuccess;
+    bool on = false;
+    if (gGammaOn && data && dataCount >= 2 && dataCount <= 65536 && (channelCount == 1 || channelCount == 3) &&
+        dataWidth >= 1 && dataWidth <= 16) {
+        const uint64_t maxv = (1ull << dataWidth) - 1;
+        const bool bytes = dataWidth <= 8;
+        NvU16 *dst[3] = { fRampsNext->red, fRampsNext->green, fRampsNext->blue };
+        for (unsigned ch = 0; ch < 3; ch++) {
+            const size_t base = (size_t)(channelCount == 3 ? ch : 0) * dataCount;
+            for (unsigned i = 0; i < NVKMS_LUT_ARRAY_SIZE; i++) {
+                const uint64_t pos = (uint64_t)i * (dataCount - 1) * 65536 / (NVKMS_LUT_ARRAY_SIZE - 1);
+                const unsigned k = (unsigned)(pos >> 16), k1 = k + 1 < dataCount ? k + 1 : k;
+                const uint64_t fr = pos & 0xffff;
+                uint64_t a = bytes ? ((const uint8_t *)data)[base + k] : ((const uint16_t *)data)[base + k];
+                uint64_t b = bytes ? ((const uint8_t *)data)[base + k1] : ((const uint16_t *)data)[base + k1];
+                if (a > maxv) a = maxv;
+                if (b > maxv) b = maxv;
+                uint64_t v = (a * (65536 - fr) + b * fr) * 65535 / (maxv * 65536);
+                if (v > 65535) v = 65535;
+                dst[ch][i] = (NvU16)v;
+                const int64_t ideal = (int64_t)((uint64_t)i * 65535 / (NVKMS_LUT_ARRAY_SIZE - 1));
+                const int64_t d = (int64_t)v - ideal;
+                if (d > 256 || d < -256) on = true;
+            }
+        }
+    }
+    if (fGammaCalls <= 6 || (fGammaCalls % 500) == 0)
+        FBLOG("fbgm1: fb%u gamma #%u: %u ch x %u entries x %u bits -> LUT %s", fIndex, fGammaCalls, (unsigned)channelCount,
+              (unsigned)dataCount, (unsigned)dataWidth, on ? "ON" : "off (identity)");
+    if (!on && !fLutOn && !fLutHw) return kIOReturnSuccess;   // straight table, LUT already off: nothing to do
+    if (fFadeLevel < 1024) { NVRMDisplayGate g2; if (on) memcpy(fRamps, fRampsNext, sizeof *fRamps); fLutOn = on; return kIOReturnSuccess; }
+    NVRMDisplayGate gate;
+    if (on) memcpy(fRamps, fRampsNext, sizeof *fRamps);
+    fLutOn = on; fLutDirty = true;
+    if (gate.valid()) lutCommit("gamma");
+    return kIOReturnSuccess;
+}
+// A commit that only carries the output LUT (no layer changes). Caller holds the display gate. When the head is not
+// lit (mode not set, display sleep, closed lid) the LUT stays pending and the relight modeset carries it.
+bool NVRMNVDAFramebuffer::lutCommit(const char *why)
+{
+    if (!fLutDirty) return true;
+    if (fConsoleAperture || !fModeSet || !fConnected || fPanelOff || fClamOff || !fKms || !fDev || fHead >= 8 ||
+        !fKms->applyModeSetConfig) return false;
+    struct NvKmsKapiRequestedModeSetConfig *cfg = (struct NvKmsKapiRequestedModeSetConfig *)IOMalloc(sizeof *cfg);
+    struct NvKmsKapiModeSetReplyConfig *rep = (struct NvKmsKapiModeSetReplyConfig *)IOMalloc(sizeof *rep);
+    if (!cfg || !rep) { if (cfg) IOFree(cfg, sizeof *cfg); if (rep) IOFree(rep, sizeof *rep); return false; }
+    nvu_zero(cfg, sizeof *cfg); nvu_zero(rep, sizeof *rep);
+    cfg->headsMask = 1u << fHead;
+    struct NvKmsKapiHeadRequestedConfig *hr = &cfg->headRequestedConfig[fHead];
+    hr->modeSetConfig.bActive = NV_TRUE;
+    hr->modeSetConfig.numDisplays = 1;
+    hr->modeSetConfig.displays[0] = fDisplay;
+    hr->modeSetConfig.mode = fMode;
+    // fbgm3: NVKMS refuses a LUT change while the previous one is still being loaded (IN_PROGRESS) - wait for it first
+    if (fKms->checkLutNotifier) fKms->checkLutNotifier(fDev, fHead, NV_TRUE);
+    NvBool ok = submitConfig(cfg, rep, NV_TRUE);
+    int rc = (int)rep->flipResult;
+    if (!ok && rc == NV_KMS_FLIP_RESULT_IN_PROGRESS) {
+        if (fKms->checkLutNotifier) fKms->checkLutNotifier(fDev, fHead, NV_TRUE);
+        IOSleep(2);
+        nvu_zero(rep, sizeof *rep);
+        ok = submitConfig(cfg, rep, NV_TRUE); rc = (int)rep->flipResult;
+    }
+    IOFree(cfg, sizeof *cfg); IOFree(rep, sizeof *rep);
+    if (ok) { fLutCommits++; OSIncrementAtomic(&gGammaCommits); }
+    else { fLutFails++; OSIncrementAtomic(&gGammaFails); }
+    if (fLutCommits + fLutFails <= 8 || !ok)
+        FBLOG("fbgm1: fb%u head %u LUT commit (%s, gamma %s, fade %u/1024) -> %u rc %d", fIndex, fHead, why, fLutOn ? "on" : "straight",
+              fFadeLevel, (unsigned)ok, rc);
+    return ok ? true : false;
+}
+static int gWakeFadeMs = 300, gSleepFadeMs = 200;   // y540 fbgm2
+// fbgm4: the panel's backlight comes on about 140 ms after the modeset that lights the head (webcam), so the ramp
+// waits this long at black first - otherwise most of it ran behind a dark backlight and the panel appeared at once
+static int gWakeFadeHoldMs = 180;
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_wake_fade_hold_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &gWakeFadeHoldMs, 0,
+           "y540 fbgm4: ms the internal panel stays black after a display wake before the fade-in starts");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_wake_fade_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &gWakeFadeMs, 0,
+           "y540 fbgm2: internal panel fades in over this many ms when the display wakes (0 = lit at once as before)");
+SYSCTL_INT(_debug, OID_AUTO, nvrmfb_sleep_fade_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &gSleepFadeMs, 0,
+           "y540 fbgm2: internal panel fades out over this many ms before the display sleeps (0 = off at once as before)");
+static inline unsigned nvrmSmooth1024(uint64_t num, uint64_t den)   // smoothstep(num/den) * 1024
+{
+    if (!den || num >= den) return 1024;
+    const uint64_t t = num * 1024 / den;
+    return (unsigned)((t * t * (3 * 1024 - 2 * t)) / (1024ull * 1024));
+}
+void NVRMNVDAFramebuffer::fadeBuild(unsigned level)
+{
+    if (!fRampsFade) return;
+    NvU16 *dst[3] = { fRampsFade->red, fRampsFade->green, fRampsFade->blue };
+    const NvU16 *src[3] = { fRamps ? fRamps->red : nullptr, fRamps ? fRamps->green : nullptr, fRamps ? fRamps->blue : nullptr };
+    for (unsigned c = 0; c < 3; c++)
+        for (unsigned i = 0; i < NVKMS_LUT_ARRAY_SIZE; i++) {
+            const uint32_t base = (fLutOn && src[c]) ? src[c][i] : (uint32_t)((uint64_t)i * 65535 / (NVKMS_LUT_ARRAY_SIZE - 1));
+            dst[c][i] = (NvU16)((uint64_t)base * level / 1024);
+        }
+}
+void NVRMNVDAFramebuffer::fadeSchedule(unsigned ms)
+{
+    if (!fFadeCall) fFadeCall = thread_call_allocate(fadeFire, this);
+    if (!fFadeCall) { fFadeIn = false; fFadeLevel = 1024; fLutDirty = true; return; }
+    uint64_t dl; clock_interval_to_deadline(ms, kMillisecondScale, &dl);
+    retain();
+    if (thread_call_enter_delayed(fFadeCall, dl)) release();
+}
+void NVRMNVDAFramebuffer::fadeFire(thread_call_param_t p0, thread_call_param_t)
+{
+    NVRMNVDAFramebuffer *me = (NVRMNVDAFramebuffer *)p0;
+    NVRMCallReference callReference(me);
+    if (OSAddAtomic(0, &me->fStopping)) return;
+    NVRMDisplayGate gate;
+    if (!gate.valid()) { me->fFadeIn = false; me->fFadeLevel = 1024; me->fLutDirty = true; return; }
+    if (!me->fFadeIn || me->fPanelOff) return;
+    const uint64_t nowAbs = mach_absolute_time();
+    if (nowAbs < me->fFadeT0) {   // fbgm4: still in the hold at black
+        uint64_t left = 0; absolutetime_to_nanoseconds(me->fFadeT0 - nowAbs, &left);
+        me->fadeSchedule((unsigned)(left / 1000000) + 1); return;
+    }
+    uint64_t ns = 0; absolutetime_to_nanoseconds(nowAbs - me->fFadeT0, &ns);
+    const unsigned level = nvrmSmooth1024(ns / 1000000, me->fFadeMs);
+    if (level >= 1024) { me->fFadeIn = false; me->fFadeLevel = 1024; }
+    else { me->fadeBuild(level); me->fFadeLevel = level; }
+    me->fLutDirty = true; me->fFadeSteps++;
+    const bool ok = me->lutCommit("wake fade");
+    if (!ok) {
+        me->fFadeIn = false; me->fFadeLevel = 1024; me->fLutDirty = true; me->lutCommit("wake fade abort");
+        PMLOG("fbgm2: fb%u wake fade ABORTED at step %u (LUT commit refused)", me->fIndex, me->fFadeSteps);
+        return;
+    }
+    if (me->fFadeIn) me->fadeSchedule(16);
+    else PMLOG("fbgm2: fb%u wake fade-in done: %llu ms, %u steps", me->fIndex, (unsigned long long)(ns / 1000000), me->fFadeSteps);
+}
+void NVRMNVDAFramebuffer::lutForceOff(const char *why)
+{
+    NVRMDisplayGate gate;
+    if (!fLutOn && !fLutHw) return;   // fbgm5: already straight
+    fLutOn = false; fLutDirty = true;
+    if (gate.valid()) lutCommit(why);
+}
+void NVRMNVDAFramebuffer::pmInstall()
+{
+    if (gPmHelper) return;
+    static bool sysctls;
+    if (!sysctls) {
+        sysctls = true; nvrmPmInfo();
+        sysctl_register_oid(&sysctl__debug_nvrmfb_pm_test); sysctl_register_oid(&sysctl__debug_nvrmfb_pm_enable);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_pm_info);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_relink); sysctl_register_oid(&sysctl__debug_nvrmfb_relink_on_wake);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_relink_gap_ms);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_panel_off);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_clamshell);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_gamma); sysctl_register_oid(&sysctl__debug_nvrmfb_gamma_calls);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_gamma_lut_on); sysctl_register_oid(&sysctl__debug_nvrmfb_gamma_commits);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_gamma_fails);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_wake_fade_ms); sysctl_register_oid(&sysctl__debug_nvrmfb_sleep_fade_ms);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_wake_fade_hold_ms);
+        sysctl_register_oid(&sysctl__debug_nvrmfb_backlight); sysctl_register_oid(&sysctl__debug_nvrmfb_dpyattr_probe);
+        if (!gRelinkCall) gRelinkCall = thread_call_allocate(nvrmRelinkFire, nullptr);
+    }
+    const uintptr_t pfv = (uintptr_t)fPhysForVa, kapi = (uintptr_t)fKms, slide = pfv - kPmOffPhysForVa;
+    if (pfv && kapi && kapi - kPmOffKapiTable == slide) gNvrmSlideOk = slide;   // y540 fbbl11
+    if (!pfv || !kapi || kapi - kPmOffKapiTable != slide) {
+        PMLOG("pm: NVRM layout differs (phys-for-va 0x%lx, kapi 0x%lx) - GPU sleep support OFF", (unsigned long)pfv, (unsigned long)kapi);
+        return;
+    }
+    static const struct { uintptr_t off; const uint8_t *sig; const char *name; } kChk[] = {
+        { kPmOffRmPower, kPmSigRmPower, "rm_power_management" }, { kPmOffKmsSuspend, kPmSigKmsSuspend, "nvKmsSuspend" },
+        { kPmOffKmsResume, kPmSigKmsResume, "nvKmsResume" }, { kPmOffGpuState, kPmSigGpuState, "nv_xnu_gpu_state" },
+        { kPmOffUsedRam, kPmSigUsedRam, "memmgrGetUsedRamSize" } };
+    for (const auto &c : kChk)
+        if (memcmp((const void *)(slide + c.off), c.sig, 16)) {
+            PMLOG("pm: %s code differs from NVRM 1.13 - GPU sleep support OFF", c.name);
+            return;
+        }
+    gPm.slide = slide;
+    gPm.rmPower = (pm_rm_power_t)(slide + kPmOffRmPower);
+    gPm.kmsSuspend = (pm_kms_t)(slide + kPmOffKmsSuspend); gPm.kmsResume = (pm_kms_t)(slide + kPmOffKmsResume);
+    gPm.gpuState = (pm_gpu_state_t)(slide + kPmOffGpuState); gPm.usedRam = (pm_used_ram_t)(slide + kPmOffUsedRam);
+    gPm.kmsLock = (IOLock **)(slide + kPmOffKmsLock);
+    IOPCIDevice *pci = OSDynamicCast(IOPCIDevice, pciNub());
+    if (!pci) { PMLOG("pm: no IOPCIDevice - GPU sleep support OFF"); return; }
+    if (!gPmWaitLock) gPmWaitLock = IOLockAlloc();
+    if (!gPmTestCall) gPmTestCall = thread_call_allocate(nvrmPmTestFire, nullptr);
+    NVRMFBPowerHelper *h = OSTypeAlloc(NVRMFBPowerHelper);
+    if (!gPmWaitLock || !gPmTestCall || !h || !h->init()) {
+        if (h) h->release();
+        PMLOG("pm: allocation failed - GPU sleep support OFF"); return;
+    }
+    pci->retain(); gPmPci = pci; gPmGpuId = fGpuId; gPmHelper = h;
+    gPm.ok = true;
+    const IOPMPowerFlags f = pci->registerInterestedDriver(h);
+    h->PMinit();
+    pci->joinPMtree(h);
+    h->registerPowerDriver(h, kPmHelperStates, 2);
+    h->changePowerStateTo(1);
+    gPmSleepNote = registerPrioritySleepWakeInterest(nvrmPmSleepWake, this, nullptr);
+    void *nv = gPm.gpuState(); uint8_t *nvp = nv ? *(uint8_t **)nv : nullptr; uint8_t *gpu = nvp ? *(uint8_t **)nvp : nullptr;
+    PMLOG("pm: GPU sleep support ON (NVRM slide 0x%lx, PCI power flags 0x%lx, sleep notifier %p; s0ix %d tegra %d rg %d gc6 %d/%d)",
+          (unsigned long)slide, (unsigned long)f, gPmSleepNote, nvp ? nvp[kNvpS0ix] : -1, gpu ? gpu[kGpuTegra] : -1,
+          gpu ? gpu[kGpuRgSup] : -1, gpu ? gpu[kGpuGc6Sup] : -1, nvp ? nvp[kNvpGc6Up] : -1);
+    nvrmPmInfo();
+}
+void NVRMNVDAFramebuffer::pmUninstall()
+{
+    if (gPmSleepNote) { gPmSleepNote->remove(); gPmSleepNote = nullptr; }
+    if (gPmPci && gPmHelper) gPmPci->deRegisterInterestedDriver(gPmHelper);
+    if (gPmHelper) { gPmHelper->PMstop(); gPmHelper->release(); gPmHelper = nullptr; }
+    if (gPmPci) { gPmPci->release(); gPmPci = nullptr; }
+    gPm.ok = false;
+    nvrmPmInfo();
+}
+// y540 fbpm6: IOFramebuffer's systemWork sends WillSleep(info 0) once per system sleep, dark-wake re-sleeps included
+IOReturn NVRMNVDAFramebuffer::sleepNoteHandler(OSObject *self, void *, IOFramebuffer *, IOIndex event, void *info)
+{
+    NVRMNVDAFramebuffer *me = OSDynamicCast(NVRMNVDAFramebuffer, self);
+    if (me && event == kIOFBNotifyWillSleep && !info) {
+        const SInt32 n = OSIncrementAtomic(&me->fSleepDisables) + 1;
+        PMLOG("pm: fb%u WillSleep(0) - system sleep %d since the display was last powered on", me->fIndex, (int)n);
+    }
+    return kIOReturnSuccess;
+}
+bool NVRMNVDAFramebuffer::pmRelight()
+{
+    if (fClamOff) { PMLOG("pm: fb%u stays dark - offline for the closed lid", fIndex); return false; }   // fbbl10
+    fSubmissionSeen = false; fSubmissionFaulted = false; fCscSwap = false;
+    if (fConsoleAperture || !fModeSet || !fConnected || !fSurf || !fKms || !fDev) {
+        PMLOG("pm: fb%u not re-lit (mode set %u, connected %u, console aperture %u)", fIndex, (unsigned)fModeSet,
+              (unsigned)fConnected, (unsigned)fConsoleAperture);
+        return false;
+    }
+    const bool swap = fFrontSurf && fFrontL10r;
+    fNextSwap = swap;
+    // y540 fbgm2: a display wake lights the internal panel black (output LUT at 0) in the same modeset, then fades in
+    const bool fadeWake = fInternal && fPanelOff && gWakeFadeMs > 0 && gWakeFadeMs <= 3000 && fRampsFade && fRamps;
+    if (fadeWake) { fadeBuild(0); fFadeLevel = 0; fFadeIn = false; fLutDirty = true; }
+    const bool ok = reflip();
+    if (fadeWake) {
+        if (ok) {
+            const unsigned hold = (gWakeFadeHoldMs >= 0 && gWakeFadeHoldMs <= 1000) ? (unsigned)gWakeFadeHoldMs : 0;
+            uint64_t holdAbs = 0; nanoseconds_to_absolutetime((uint64_t)hold * 1000000, &holdAbs);
+            fFadeIn = true; fFadeT0 = mach_absolute_time() + holdAbs; fFadeMs = (unsigned)gWakeFadeMs; fFadeSteps = 0;
+            fadeSchedule(hold ? hold : 16);
+        }
+        else { fFadeLevel = 1024; fLutDirty = true; }
+    }
+    const bool cur = (ok && fCursorEnabled && fCurSurf && fCurHaveImage) ? cursorApply() : false;
+    PMLOG("pm: fb%u head %u re-lit -> %u (flipResult %d, front %s%s), cursor %u", fIndex, fHead, (unsigned)ok, fReflipRc,
+          fFrontSurf ? "last flipped surface" : "boot surface", swap ? " l10r" : "", (unsigned)cur);
+    if (ok) { fPanelOff = false; fPanelWakePending = false; }
+    return ok;
+}
+// y540 panel relink (fbbl2): the internal eDP panel sometimes goes dark - backlight off - while the GPU keeps scanning
+// out, with no NVKMS or RM event (19:07 and 21:15 on 10-14; the same symptom under Windows and Ubuntu stayed dark until
+// a reboot). A refresh-rate switch, a modeset to a different mode, brought it back each time. A commit of the same mode
+// is not a modeset to NVKMS, so the head is switched off and then modeset again with the current mode and surface
+// (pmRelight), all inside the display gate so no flip lands in between.
+bool NVRMNVDAFramebuffer::relinkPanel(const char *why)
+{
+    const uint64_t t0 = mach_absolute_time();
+    NVRMDisplayGate gate;
+    if (!gate.valid()) { PMLOG("relink (%s): display gate closed (GPU asleep) - skipped", why); return false; }
+    if (fConsoleAperture || !fModeSet || !fConnected || !fSurf || !fKms || !fDev || fHead >= 8 || !fKms->applyModeSetConfig) {
+        PMLOG("relink (%s): fb%u not ready (mode set %u, connected %u, console aperture %u) - skipped", why, fIndex,
+              (unsigned)fModeSet, (unsigned)fConnected, (unsigned)fConsoleAperture);
+        return false;
+    }
+    int offRc = -1;
+    const bool off = fPanelOff ? true : headOffCommit(&offRc);
+    const uint64_t t1 = mach_absolute_time();
+    const int gap = (gRelinkGapMs >= 0 && gRelinkGapMs <= 2000) ? gRelinkGapMs : 100;
+    if (gap) IOSleep((unsigned)gap);
+    const uint64_t t2 = mach_absolute_time();
+    const bool on = pmRelight();
+    const uint64_t t3 = mach_absolute_time();
+    fRelinks++;
+    setProperty("NVRMRelinks", (unsigned long long)fRelinks, 32);
+    PMLOG("relink (%s): fb%u head %u off %u (rc %d) on %u | off %llu ms, gap %llu ms, on %llu ms (relink #%u)", why, fIndex,
+          fHead, (unsigned)off, offRc, (unsigned)on, pmMs(t0, t1), pmMs(t1, t2), pmMs(t2, t3), fRelinks);
+    return on;
+}
+// One commit that switches this framebuffer's head off (no layers, no cursor). Caller holds the display gate.
+bool NVRMNVDAFramebuffer::headOffCommit(int *rcOut)
+{
+    if (rcOut) *rcOut = -1;
+    struct NvKmsKapiRequestedModeSetConfig *cfg = (struct NvKmsKapiRequestedModeSetConfig *)IOMalloc(sizeof *cfg);
+    struct NvKmsKapiModeSetReplyConfig *rep = (struct NvKmsKapiModeSetReplyConfig *)IOMalloc(sizeof *rep);
+    if (!cfg || !rep) { if (cfg) IOFree(cfg, sizeof *cfg); if (rep) IOFree(rep, sizeof *rep); return false; }
+    nvu_zero(cfg, sizeof *cfg); nvu_zero(rep, sizeof *rep);
+    cfg->headsMask = 1u << fHead;
+    struct NvKmsKapiHeadRequestedConfig *hr = &cfg->headRequestedConfig[fHead];
+    hr->modeSetConfig.bActive = NV_FALSE;
+    hr->modeSetConfig.numDisplays = 0;
+    hr->flags.activeChanged = hr->flags.displaysChanged = NV_TRUE;
+    for (unsigned i = 0; i < NVKMS_KAPI_LAYER_MAX; i++) {
+        hr->layerRequestedConfig[i].config.surface = nullptr;
+        hr->layerRequestedConfig[i].flags.surfaceChanged = NV_TRUE;
+    }
+    hr->cursorRequestedConfig.surface = nullptr;
+    hr->cursorRequestedConfig.flags.surfaceChanged = NV_TRUE;
+    const NvBool ok = fKms->applyModeSetConfig(fDev, cfg, rep, NV_TRUE);
+    if (rcOut) *rcOut = (int)rep->flipResult;
+    IOFree(cfg, sizeof *cfg); IOFree(rep, sizeof *rep);
+    return ok ? true : false;
+}
+// y540 display sleep (fbbl3): IOFramebuffer powers the framebuffer off as soon as macOS sleeps the display (Sleep in the
+// Apple menu, the lid, the display-sleep timer), but the head stayed lit, so the last frame stayed on the panel through
+// the 15 s dark-wake linger and the GPU suspend - about 20 s - and every dark wake re-lit it. A Mac's panel goes dark at
+// once. The head is switched off here; flips and cursor moves while it is off only record the newest surface, and the
+// next display power-on (or the GPU resume of a full wake) lights it with a full modeset - which also re-trains the eDP
+// link. sysctl debug.nvrmfb_panel_off=0 keeps the head lit as before.
+bool NVRMNVDAFramebuffer::panelPowerOff(const char *why)
+{
+    const uint64_t t0 = mach_absolute_time();
+    NVRMDisplayGate gate;
+    if (!gate.valid() || fPanelOff) return fPanelOff;
+    if (fConsoleAperture || !fModeSet || !fConnected || !fSurf || !fKms || !fDev || fHead >= 8 || !fKms->applyModeSetConfig) return false;
+    // y540 fbgm2: fade the internal panel out before its head goes off (the display gate stays held: flips wait)
+    if (fInternal && gSleepFadeMs > 0 && gSleepFadeMs <= 2000 && fRampsFade && fRamps) {
+        fFadeIn = false;
+        const uint64_t f0 = mach_absolute_time(); unsigned steps = 0;
+        for (;;) {
+            uint64_t ns = 0; absolutetime_to_nanoseconds(mach_absolute_time() - f0, &ns);
+            const unsigned up = nvrmSmooth1024(ns / 1000000, (unsigned)gSleepFadeMs);
+            const unsigned level = 1024 - up;
+            fadeBuild(level); fFadeLevel = level < 1024 ? level : 1023; fLutDirty = true;
+            if (!lutCommit("sleep fade")) break;
+            steps++;
+            if (!level) break;
+            IOSleep(12);
+        }
+        PMLOG("fbgm2: fb%u sleep fade-out: %u steps in %llu ms", fIndex, steps, pmMs(f0, mach_absolute_time()));
+    }
+    int rc = -1;
+    const bool ok = headOffCommit(&rc);
+    if (ok) { fPanelOff = true; fPanelWakePending = false; }
+    fFadeIn = false; fFadeLevel = 1024; fLutDirty = true;   // the relight starts from a known LUT state
+    PMLOG("panel off (%s): fb%u head %u -> %u (rc %d) in %llu ms", why, fIndex, fHead, (unsigned)ok, rc, pmMs(t0, mach_absolute_time()));
+    return ok;
+}
+// fbbl4: lighting the panel at display power-on showed the frame flipped before the display slept - the unlocked desktop
+// - for two frames before the lock screen WindowServer draws after the wake (webcam, 22:00:53). The panel now lights
+// with WindowServer's first frame after the power-on; this fallback lights it with the newest frame if none came.
+void NVRMNVDAFramebuffer::panelOnFire(thread_call_param_t p0, thread_call_param_t)
+{
+    NVRMNVDAFramebuffer *me = (NVRMNVDAFramebuffer *)p0;
+    NVRMCallReference callReference(me);
+    if (OSAddAtomic(0, &me->fStopping)) return;
+    NVRMDisplayGate gate; if (!gate.valid()) return;
+    if (!me->fPanelOff || !me->fPanelWakePending) return;
+    const uint64_t t0 = mach_absolute_time();
+    const bool lit = me->pmRelight();
+    PMLOG("panel on (no new frame in time): fb%u -> %u in %llu ms", me->fIndex, (unsigned)lit, pmMs(t0, mach_absolute_time()));
+}
+// fbbl10 clamshell. IOGraphics turns its own clamshell handling off for NVIDIA GPUs (kIOGDbgNoClamshellOffline, "IOG CS_OFF")
+// and leaves it to the vendor driver: 1 s after the lid closes or opens it sends kConnectionProbe to every framebuffer.
+// Apple's NVIDIA driver answers it by reporting the built-in panel disconnected while the lid is closed and an external
+// display is connected; IOFramebuffer then takes the panel offline and WindowServer moves the menu bar and windows to the
+// external display. With the lid open again (or no external display left - then the Mac sleeps, as the desktop mode
+// counts only external displays) the panel reports itself connected and lights with WindowServer's first frame for it.
+void NVRMNVDAFramebuffer::clamshellProbe(const char *why)
+{
+    if (!fInternal) return;
+    bool closed = false;
+    if (IOPMrootDomain *rd = getPMRootDomain()) {
+        OSObject *o = rd->copyProperty(kAppleClamshellStateKey);
+        closed = (o == kOSBooleanTrue);
+        OSSafeReleaseNULL(o);
+    }
+    bool ext = false;
+    {
+        IORecursiveLock *rl = startLock(); if (rl) IORecursiveLockLock(rl);
+        for (int k = 0; k < 8; k++) { NVRMNVDAFramebuffer *fb = gFBs[k]; if (fb && fb != this && !fb->fInternal && fb->fConnected) ext = true; }
+        if (rl) IORecursiveLockUnlock(rl);
+    }
+    const bool off = gClamshellOffline && closed && ext;
+    if (off == fClamOff) {
+        PMLOG("clamshell (%s): lid %s, external display %s - panel stays %s", why, closed ? "closed" : "open", ext ? "connected" : "none",
+              fClamOff ? "offline" : "online");
+        return;
+    }
+    if (off) {
+        fClamOff = true;
+        const bool dark = panelPowerOff("clamshell");
+        PMLOG("clamshell (%s): lid closed with an external display - fb%u reports disconnected, head off %u", why, fIndex, (unsigned)dark);
+    } else {
+        fClamOff = false;
+        if (fPanelOff) {   // light with WindowServer's first frame for the panel; the newest frame after 3 s otherwise
+            fPanelWakePending = true;
+            if (!fPanelOnCall) fPanelOnCall = thread_call_allocate(panelOnFire, this);
+            if (fPanelOnCall) {
+                uint64_t dl; clock_interval_to_deadline(3000, kMillisecondScale, &dl);
+                retain();
+                if (thread_call_enter_delayed(fPanelOnCall, dl)) release();
+            }
+        }
+        PMLOG("clamshell (%s): lid %s, external display %s - fb%u reports connected again", why, closed ? "closed" : "open",
+              ext ? "connected" : "none", fIndex);
+    }
+    if (!fClamCall) fClamCall = thread_call_allocate(clamshellFire, this);
+    if (fClamCall) { retain(); if (thread_call_enter(fClamCall)) release(); }
+}
+void NVRMNVDAFramebuffer::clamshellFire(thread_call_param_t p0, thread_call_param_t)
+{
+    NVRMNVDAFramebuffer *me = (NVRMNVDAFramebuffer *)p0;
+    NVRMCallReference callReference(me);
+    if (OSAddAtomic(0, &me->fStopping)) return;
+    if (me->fConnect.proc) me->fConnect.proc(me->fConnect.target, me->fConnect.ref);
+    else PMLOG("clamshell: fb%u has no connect interrupt registered", me->fIndex);
+}
