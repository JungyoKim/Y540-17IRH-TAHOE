--- a/plugin/nvmtl_vk.c	2026-10-15 17:57:03
+++ b/plugin/nvmtl_vk.c	2026-10-15 14:51:15
@@ -1,3 +1,4 @@
+#include <mach/mach_time.h>
 /*
  * NullMoth NVIDIA driver for macOS
  * Copyright (c) 2026 NullMoth Systems.
@@ -193,6 +194,53 @@
 #undef DECL
 #define LOAD_I(f) do { p##f = (PFN_##f)pvkGetInstanceProcAddr(g_inst, #f); if (!p##f) { nvlog("vk: missing %s", #f); return -1; } } while (0);
 #define LOAD_D(f) do { p##f = (PFN_##f)pvkGetDeviceProcAddr(g_dev, #f);   if (!p##f) { nvlog("vk: missing %s", #f); return -1; } } while (0);
+// y540 wake gate (ws38): an RM call that reaches the GPU while NVRMFB has it suspended for system sleep - a free whose
+// TLB invalidate polls the powered-off GPU - spins inside NVRM until RM's timeout (about 30 s) while holding the RM API
+// lock, and the GPU resume waits for that lock: wakes took 32-63 s whenever RenderBox pruned its texture cache right at
+// the wake (spindump 10-14 21:47: NotificationCenter in kgmmuCheckPendingInvalidates, resume in rmapiLockAcquire). The
+// calls below wait here while debug.nvrmfb_pm_info reports the GPU suspended. The answer is kept for 20 ms of
+// mach_continuous_time, which keeps counting through sleep, so the first call after a wake always asks again.
+static PFN_vkFreeMemory g_gate_FreeMemory; static PFN_vkDestroyImage g_gate_DestroyImage; static PFN_vkDestroyBuffer g_gate_DestroyBuffer;
+static PFN_vkAllocateMemory g_gate_AllocateMemory; static PFN_vkBindBufferMemory g_gate_BindBufferMemory; static PFN_vkBindImageMemory g_gate_BindImageMemory;
+static uint64_t g_gate_ok_until, g_gate_hold_ticks;
+static int nvmtl_gpu_state(void)
+{
+    char b[1200]; size_t n = sizeof b - 1;
+    if (sysctlbyname("debug.nvrmfb_pm_info", b, &n, NULL, 0) != 0) return -1;
+    b[n < sizeof b - 1 ? n : sizeof b - 1] = 0;
+    const char *st = strstr(b, " state ");
+    return st ? atoi(st + 7) : -1;
+}
+static void nvmtl_gpu_gate(void)
+{
+    if (mach_continuous_time() < __atomic_load_n(&g_gate_ok_until, __ATOMIC_RELAXED)) return;
+    if (!g_gate_hold_ticks) { mach_timebase_info_data_t tb; mach_timebase_info(&tb); g_gate_hold_ticks = 20000000ull * tb.denom / tb.numer; }
+    int waited = 0, st;
+    while ((st = nvmtl_gpu_state()) > 0 && waited < 1500) {
+        if (!waited) nvlog("gpu gate: GPU suspended for sleep (state %d) - holding an RM call until it resumes", st);
+        usleep(10000); waited++;
+    }
+    if (waited) nvlog("gpu gate: released after %d ms%s", waited * 10, st > 0 ? " (still suspended - going ahead)" : "");
+    // after a 15 s give-up, do not ask again for 10 s (no stall per call if the state ever sticks)
+    __atomic_store_n(&g_gate_ok_until, mach_continuous_time() + (st > 0 ? 500 * g_gate_hold_ticks : g_gate_hold_ticks), __ATOMIC_RELAXED);
+}
+static VKAPI_ATTR void VKAPI_CALL gate_FreeMemory(VkDevice d, VkDeviceMemory m, const VkAllocationCallbacks *a) { nvmtl_gpu_gate(); g_gate_FreeMemory(d, m, a); }
+static VKAPI_ATTR void VKAPI_CALL gate_DestroyImage(VkDevice d, VkImage i, const VkAllocationCallbacks *a) { nvmtl_gpu_gate(); g_gate_DestroyImage(d, i, a); }
