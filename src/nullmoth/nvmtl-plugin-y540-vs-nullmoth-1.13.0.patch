+// y540 spvz: spvcache entries are kept LZFSE-compressed. A WindowServer fixed_frag specialisation is 0.7 MB of SPIR-V and a
+// new pipeline read 1-2 MB of these files; on the HDD that stalled the main thread 0.3-1 s whenever the disk was busy.
+// LZFSE makes them about 3.4x smaller. Readers take both forms (magic "SVZ1" + raw length + payload); an uncompressed
+// entry of 64 KB or more is rewritten compressed after it is read. Measured after a cold boot on the HDD it did not help
+// (seek-bound, not byte-bound), so storing compressed is now opt-in: /Library/NullMoth/spvz. Reading both forms stays on.
+#define NVMTL_SPVZ_MAGIC 0x315A5653u
+static __thread uint64_t g_tls_io_ns, g_tls_io_bytes, g_tls_vk_ns;
+static _Atomic unsigned long long gSpvzIn, gSpvzRaw;
+static inline int nvmtl_spvz_on(void) { static int on = -1; if (on < 0) on = access("/Library/NullMoth/spvz", F_OK) == 0; return on; }
+static NSData *nvmtl_spvz_pack(NSData *d) {
+    if (!d || d.length < 4096 || !nvmtl_spvz_on()) return d;
+    uint32_t m0; memcpy(&m0, d.bytes, 4); if (m0 == NVMTL_SPVZ_MAGIC) return d;
+    uint8_t *buf = malloc(d.length); if (!buf) return d;
+    const size_t n = compression_encode_buffer(buf, d.length, d.bytes, d.length, NULL, COMPRESSION_LZFSE);
+    if (!n || n + 12 > d.length - d.length / 8) { free(buf); return d; }
+    NSMutableData *o = [NSMutableData dataWithCapacity:12 + n];
+    const uint32_t m = NVMTL_SPVZ_MAGIC; const uint64_t raw = d.length;
+    [o appendBytes:&m length:4]; [o appendBytes:&raw length:8]; [o appendBytes:buf length:n]; free(buf);
+    return o;
