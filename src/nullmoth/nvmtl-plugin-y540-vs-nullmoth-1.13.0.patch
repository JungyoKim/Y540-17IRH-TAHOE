+static _Atomic unsigned gSiHeldN; static _Atomic unsigned long long gSiHeldB, gSiEvict;   // NVMTLObjects.m (ws40 si-cap)
+static _Atomic unsigned long long gVidH[6];          // NVMTLObjects.m (ws34 vidcadence)
+static int nvmtl_trace_on(void);                     // NVMTLObjects.m
+static int nvmtl_pool_flag(const char *path, _Atomic uint64_t *next, _Atomic int *on, const char *name) {
+    const uint64_t now = nvmtl_pool_now();
+    if (now >= atomic_load(next)) {
+        atomic_store(next, now + 2000000000ull);
+        const int v = access(path, F_OK) != 0;
+        if (v != atomic_exchange(on, v)) syslog(LOG_NOTICE, "NullMoth-y540: %s %s", name, v ? "ON" : "OFF");
+    }
+    return atomic_load(on);
