+    (void)script; (void)function; (void)options; (void)size;
+    return NULL;
+}
+
+- (id)computeVariantWithCompilerOutput:(id)compilerOutput pipelineStatisticsOutput:(id)stats
+{
+    if (!compilerOutput) return nil;
+    NVMTLComputeVariant *v = [[NVMTLComputeVariant alloc] initWithCompilerOutput:compilerOutput
+                                                                         device:self
+                                                       pipelineStatisticsOutput:stats];
+    nvlog("vendor variant: computeVariantWithCompilerOutput: -> %s",
+          v ? "NVMTLComputeVariant" : "nil (the output was not ours)");
+    return v;
+}
+
+@end
+
+static const void *gNVMTLVariantAssoc = &gNVMTLVariantAssoc;
+
+void nvmtl_vendor_attach_sass(id device, id ps, id function)
+{
+    if (!nvmtl_vendor_enabled() || !ps || !function || !device) return;
+    NVMTLFunction *f = (NVMTLFunction *)function;
+    if (!f->_air.length) { nvlog("vendor variant: %s has no AIR text", f->_fname.UTF8String); return; }
+
+    void *c = nvmtl_vendor_compiler_handle();
+    if (!c) return;
+    static int (*Build)(void *, uint32_t, const char *, const void **, size_t *, const char **);
+    static void (*Release)(void *);
+    if (!Build) {
+        void *h = dlopen(nvmtl_vendor_plugin_path(), RTLD_NOW | RTLD_LOCAL);
+        Build = h ? (int (*)(void *, uint32_t, const char *, const void **, size_t *,
+                             const char **))dlsym(h, "NVSCompileAIRText") : NULL;
+        Release = h ? (void (*)(void *))dlsym(h, "MTLCompilerReleaseReply") : NULL;
+        if (!Build) { nvlog("vendor variant: no NVSCompileAIRText in the plugin"); return; }
+    }
+
+    const void *reply = NULL; size_t len = 0; const char *err = NULL;
+    if (Build(c, NVMTL_STAGE_COMPUTE, f->_air.UTF8String, &reply, &len, &err) != 0 || !reply || !len) {
+        nvlog("vendor variant: %s did not compile: %s", f->_fname.UTF8String,
+              err ? err : "(no message)");
+        return;
+    }
+    dispatch_data_t out = dispatch_data_create(reply, len,
+                              dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0),
+                              DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+    if (Release) Release(c);
+
+    id v = [device computeVariantWithCompilerOutput:(id)out pipelineStatisticsOutput:nil];
+    if (!v) return;
+    if (![v nvmtlBindKernel:f->_fname]) return;
+    objc_setAssociatedObject(ps, gNVMTLVariantAssoc, v, OBJC_ASSOCIATION_RETAIN);
+    NVMTLComputeVariant *cv = v;
+    nvlog("vendor variant: %s -> pipeline %p holds a variant with %u B of SASS, regs %u, %u param(s)",
+          f->_fname.UTF8String, (__bridge void *)ps, cv->_textLen, cv->_regs, cv->_nparams);
+}
+
+int nvmtl_vendor_dispatch_sass(id ps, nvk_cmdbuf *c, const uint32_t threads[3], const uint32_t tg[3])
+{
+    if (!nvmtl_vendor_enabled() || !ps || !c) return -1;
+    NVMTLComputeVariant *v = objc_getAssociatedObject(ps, gNVMTLVariantAssoc);
+    if (![v isKindOfClass:[NVMTLComputeVariant class]]) return -2;
+    if (!v->_text || !v->_textLen) return -3;
+    return nvmtl_vk_cmd_dispatch_sass(c, v->_text, v->_textLen, v->_regs, v->_smem, v->_barriers,
+                                      v->_nparams, threads, tg);
+}
+
+@interface NVMTLLibrary (VendorTwin)
+@end
+@implementation NVMTLLibrary (VendorTwin)
+@end
+
+static pthread_key_t gNVMTLInApple;
+static pthread_once_t gNVMTLInAppleOnce = PTHREAD_ONCE_INIT;
+static void nvmtl_in_apple_init(void) { pthread_key_create(&gNVMTLInApple, NULL); }
+static int nvmtl_in_apple(void)
+{
+    pthread_once(&gNVMTLInAppleOnce, nvmtl_in_apple_init);
+    return pthread_getspecific(gNVMTLInApple) != NULL;
+}
+static void nvmtl_set_in_apple(int on)
+{
+    pthread_once(&gNVMTLInAppleOnce, nvmtl_in_apple_init);
+    pthread_setspecific(gNVMTLInApple, on ? (void *)1 : NULL);
+}
+
+id nvmtl_vendor_apple_pipeline(id device, id function)
+{
+    if (!nvmtl_vendor_enabled() || !device || !function) return nil;
+    if (nvmtl_in_apple()) return nil;
+    if (!getenv("NVMTL_APPLE_PIPELINE")) return nil;
+
+    NVMTLFunction *f = (NVMTLFunction *)function;
+    if (![f isKindOfClass:[NVMTLFunction class]] || !f->_lib) {
+        nvlog("apple pipeline: no owning library on \"%s\" — cannot reach Apple's twin",
+              f->_fname.UTF8String);
+        return nil;
+    }
+
+    id twin = [(id)device nvmtlAppleTwinOf:(NVMTLLibrary *)f->_lib];
+    if (!twin) { nvlog("apple pipeline: no Apple twin for this library"); return nil; }
+
+    NSError *fe = nil;
+    id af = nil;
+    if (f->_fcv) af = [twin newFunctionWithName:f->_fname constantValues:f->_fcv error:&fe];
+    if (!af) af = [twin newFunctionWithName:f->_fname];
+    if (!af) {
+        nvlog("apple pipeline: the twin has no function \"%s\" — refusing rather than handing "
+              "Apple's compiler a function it cannot read", f->_fname.UTF8String);
+        return nil;
+    }
+
+    MTLComputePipelineDescriptor *d = [MTLComputePipelineDescriptor new];
+    d.computeFunction = af;
+    d.label = f->_fname;
+
+    SEL sel = @selector(newComputePipelineStateWithDescriptor:error:);
+    struct objc_super sup = { device, class_getSuperclass(object_getClass(device)) };
+    NSError *e = nil;
+    nvmtl_set_in_apple(1);
+    id ps = ((id (*)(struct objc_super *, SEL, id, NSError **))objc_msgSendSuper)(&sup, sel, d, &e);
+    nvmtl_set_in_apple(0);
+
+    nvlog("apple pipeline: Apple's own newComputePipelineStateWithDescriptor: for \"%s\" -> %s%s",
+          f->_fname.UTF8String, ps ? object_getClassName(ps) : "nil",
+          ps ? "" : (e ? [[e localizedDescription] UTF8String] ?: " (no reason)" : " (no error)"));
+    return ps;
+}
diff -ruN a/plugin/NVMTLVidPre.m b/plugin/NVMTLVidPre.m
--- a/plugin/NVMTLVidPre.m	1970-01-01 09:00:00
+++ b/plugin/NVMTLVidPre.m	2026-10-15 11:22:41
@@ -0,0 +1,88 @@
+/*
+ * NullMoth NVIDIA driver for macOS
+ * Copyright (c) 2026 NullMoth Systems.
+ * SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+ */
+// y540 ws48 vpre: the decoder stages each video frame into its IOSurface's family VRAM before VideoToolbox hands the
+// frame on. NVDEC frames reach their consumers as multi-plane IOSurfaces in system memory (the decoder untiles on the
+// CPU), and WindowServer used to copy every new 4K frame (P010: 16.6 MB luma + 8.3 MB chroma) over PCIe into a private
+// image in the prologue of the composite that first showed it: 3-4.4 ms of GPU time in front of that composite, twice per
+// video frame with one wallpaper video per display, so the dual-display lock screen missed vblanks while the GPU was
+// otherwise idle. A real Mac's decoder writes its frames into GPU memory that the compositor samples directly. Here the
+// copy runs on the decoder's own thread, about 0.4 s before the frame is shown and off WindowServer's queue: each plane is
+// copied from the surface's pages (imported once, sdirect cache) into the plane's family VRAM (one per surface and plane,
+// shared by every process) in 4 MB bands, and the plane's VRAM tag records the surface seed it holds. WindowServer samples a tagged plane
+// from that VRAM and skips the copy while the tag matches the seed. OFF by default (see nvmtl_vpre_off); /Library/NullMoth/vpre-on.
+static _Atomic unsigned long long gVpN, gVpBytes, gVpNs, gVpMaxNs, gVpFail, gVpSmall, gVpSeedMoved;
+static void nvmtl_vpre_fail(const char *why, IOSurfaceRef sf) {
+    const unsigned long long k = atomic_fetch_add(&gVpFail, 1) + 1;
+    if (k <= 8 || (k & (k - 1)) == 0)
+        syslog(LOG_NOTICE, "NullMoth-y540: vpre: surface %u not staged (%s) - its consumers copy it themselves (%llu so far)", sf ? (unsigned)IOSurfaceGetID(sf) : 0u, why, k);
+}
+// ws51: the copy runs on a background queue; the decoder hands the frame on at once. ws48-50 waited for it on the decoder
+// thread (about 5 ms a picture), and the lock screen's two in-process 4K streams then decoded late. The tag is written only
+// after the copy finished and the surface still has the seed it had when the frame was emitted, so a consumer that comes
+// first, or a frame the decoder wrote again meanwhile, simply takes the consumer's own copy.
+static _Atomic int gVpPending; static _Atomic unsigned long long gVpBusy;
+static void nvmtl_vpre_stage(IOSurfaceRef sf, uint32_t seed, uint64_t t0) {
+    const size_t np = IOSurfaceGetPlaneCount(sf);
+    @autoreleasepool {
+        NVMTLSurfImport *imp = nvmtl_si_get(sf);
+        if (!imp) { nvmtl_vpre_fail("its pages could not be imported", sf); return; }
+        nvk_queue *q = nvmtl_device_queue();
+        if (!q) { nvmtl_vpre_fail("no queue", sf); return; }
+        nvk_buffer vb[3]; memset(vb, 0, sizeof vb);
+        size_t off[3] = { 0 }, need[3] = { 0 }, total = 0; unsigned got = 0; const char *why = NULL;
+        for (size_t p = 0; p < np; p++) {
+            const size_t row = IOSurfaceGetBytesPerRowOfPlane(sf, p), h = IOSurfaceGetHeightOfPlane(sf, p);
+            const uintptr_t pb = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(sf, p);
+            need[p] = row * h;
+            if (!row || !h || row % 32) { why = "plane pitch not 32-byte aligned"; break; }
+            if (pb < imp->_base || pb - imp->_base + need[p] > imp->_size) { why = "plane outside the import"; break; }
+            off[p] = pb - imp->_base;
+            if (nvmtl_icache_get(sf, (uint32_t)p, need[p], &vb[p])) { why = "family VRAM refused"; break; }
+            got++; total += need[p];
+        }
+        // in bands (ws48 band): WindowServer's composites get the GPU between them
+        const size_t band = nvmtl_band_bytes();
+        for (size_t p = 0; p < got && !why; p++)
+            for (size_t o = 0; o < need[p] && !why; o += band) {
+                if (IOSurfaceGetSeed(sf) != seed) { why = "written again before the copy finished"; break; }
+                if (nvmtl_vk_copy_buffer(q, &imp->_b, off[p] + o, &vb[p], o, MIN(band, need[p] - o))) why = "GPU copy";
+            }
+        for (unsigned p = 0; p < got; p++) nvmtl_icache_put(&vb[p]);
+        if (!why && IOSurfaceGetSeed(sf) != seed) { atomic_fetch_add(&gVpSeedMoved, 1); why = "written again during the copy"; }
+        if (why) { nvmtl_vpre_fail(why, sf); return; }
+        for (size_t p = 0; p < np; p++) nvmtl_vram_tag_set(sf, p, seed);
+        const uint64_t dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0;
+        const unsigned long long n = atomic_fetch_add(&gVpN, 1) + 1;
+        atomic_fetch_add(&gVpBytes, total); atomic_fetch_add(&gVpNs, dt);
+        uint64_t mx = atomic_load(&gVpMaxNs); while (dt > mx && !atomic_compare_exchange_weak(&gVpMaxNs, &mx, dt)) {}
+        if (n <= 4 || (n & (n - 1)) == 0 || n % 3000 == 0)
+            syslog(LOG_NOTICE, "NullMoth-y540: vpre: staged surface %u (%zu planes, %zu KB, seed %u) %.2f ms after emit | %llu frames, avg %.2f ms, max %.2f ms, %llu MB, failed %llu, busy-skipped %llu (%s)",
+                  (unsigned)IOSurfaceGetID(sf), np, total >> 10, seed, dt / 1e6, n, atomic_load(&gVpNs) / 1e6 / (double)n,
+                  atomic_load(&gVpMaxNs) / 1e6, atomic_load(&gVpBytes) >> 20, atomic_load(&gVpFail), atomic_load(&gVpBusy), getprogname());
+    }
+}
+static void nvmtl_vpre_emit(void *img) {
+    if (nvmtl_vpre_off()) return;
+    static IOSurfaceRef (*getIOS)(void *);
+    if (!getIOS) getIOS = (IOSurfaceRef (*)(void *))dlsym(RTLD_DEFAULT, "CVPixelBufferGetIOSurface");
+    IOSurfaceRef sf = getIOS ? getIOS(img) : NULL;
+    if (!sf) return;
+    const size_t np = IOSurfaceGetPlaneCount(sf);
+    if (np < 2 || np > 3) return;
+    if ((unsigned long long)IOSurfaceGetWidth(sf) * IOSurfaceGetHeight(sf) < 1280ull * 720ull) { atomic_fetch_add(&gVpSmall, 1); return; }
+    if (atomic_load(&gVpPending) >= 4) { atomic_fetch_add(&gVpBusy, 1); return; }
+    static dispatch_queue_t q; static dispatch_once_t once;
+    dispatch_once(&once, ^{ q = dispatch_queue_create("nvmtl.vpre", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INITIATED, 0)); });
+    const uint32_t seed = IOSurfaceGetSeed(sf); const uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    // a pool surface seen for the first time gets a not-current tag (seed 0) before the frame goes out, so a consumer that
+    // makes its texture before the copy lands still puts it on the family VRAM (and copies this one frame itself)
+    if (!nvmtl_vram_tagged(sf, 0)) for (size_t p = 0; p < np; p++) nvmtl_vram_tag_set(sf, p, 0);
+    CFRetain(sf); atomic_fetch_add(&gVpPending, 1);
+    dispatch_async(q, ^{
+        if (nvmtl_vk_surface_share_on()) nvmtl_vpre_stage(sf, seed, t0);
+        atomic_fetch_sub(&gVpPending, 1); CFRelease(sf);
+    });
+}
