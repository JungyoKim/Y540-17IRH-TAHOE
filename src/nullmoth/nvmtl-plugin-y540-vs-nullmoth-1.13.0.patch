+// y540 ws34j vidtime: while notify com.nullmoth.vidlog is 1, the HEVC decoder's frame output (VTDecoderSessionEmitDecodedFrame,
+// reached through libnvdec_hevc's own __got slot, which this swaps for a wrapper) and WindowServer's pick of a new 4K video
+// frame (nvmtl_vid_tick) each log the frame's IOSurface ID with CLOCK_UPTIME_RAW, so the decode-to-pick margin can be read.
+#include <notify.h>
+#include <mach-o/loader.h>
+#include <sys/mman.h>
+static int nvmtl_vidlog_on(void) {
+    static int tok = -1; static _Atomic uint64_t next; static _Atomic int on = 0;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now < atomic_load(&next)) return atomic_load(&on);
+    atomic_store(&next, now + 1000000000ull);
+    if (tok == -1) { if (notify_register_check("com.nullmoth.vidlog", &tok) != NOTIFY_STATUS_OK) tok = -2; }
+    uint64_t st = 0; if (tok >= 0 && notify_get_state(tok, &st) == NOTIFY_STATUS_OK) atomic_store(&on, st != 0);
+    return atomic_load(&on);
+}
+typedef int32_t (*nvmtl_emit_fn)(void *, void *, int32_t, uint32_t, void *);
+static nvmtl_emit_fn g_nvmtl_emit_real;
+static void nvmtl_vpre_emit(void *img);   // y540 ws48 vpre (NVMTLVidPre.m)
+static int32_t nvmtl_emit_wrap(void *s, void *f, int32_t st, uint32_t fl, void *img) {
+    if (img && st == 0) nvmtl_vpre_emit(img);
+    if (img && nvmtl_vidlog_on()) {
+        static void *(*getIOS)(void *); static uint32_t (*getID)(void *);
+        if (!getIOS) getIOS = (void *(*)(void *))dlsym(RTLD_DEFAULT, "CVPixelBufferGetIOSurface");
+        if (!getID) getID = (uint32_t (*)(void *))dlsym(RTLD_DEFAULT, "IOSurfaceGetID");
+        void *sf = getIOS ? getIOS(img) : NULL;
+        syslog(LOG_NOTICE, "NullMoth-y540: videmit %u %llu", (sf && getID) ? getID(sf) : 0u,
+               (unsigned long long)clock_gettime_nsec_np(CLOCK_UPTIME_RAW));
+    }
+    return g_nvmtl_emit_real(s, f, st, fl, img);
+}
+// y540 ws45 detile1: libnvdec_hevc turns each decoded picture from NVDEC's block-linear layout into the pixel buffer with
+// dispatch_apply(8, ...) on the user-initiated global queue. The copy is memory bound, so eight threads finished a 4K 10-bit
+// picture in 3.7 ms against 4.4 ms on one, while burning about 30 ms of CPU a picture: QuickTime Player playing a 4K HEVC
+// file used about one core for the detile alone, and the lock screen's wallpaper process 1.6-1.8 cores. libnvdec_hevc's
+// dispatch_apply slot is now wrapped: the chunks run on NVMTL_DETILE_THREADS threads (default 1, on the decoder's own
+// thread). /Library/NullMoth/detile-parallel brings back the library's own eight-way apply.
+typedef void (*nvmtl_dapply_fn)(size_t, dispatch_queue_t, void (^)(size_t));
+static nvmtl_dapply_fn g_nvmtl_dapply_real;
+static _Atomic unsigned long long g_detile_calls;
+static int nvmtl_detile_threads(void) {
+    static int t = -1;
+    if (t < 0) { const char *e = getenv("NVMTL_DETILE_THREADS"); int v = e ? atoi(e) : 1; t = v < 1 ? 1 : v > 8 ? 8 : v; }
+    static _Atomic uint64_t next; static _Atomic int par;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= atomic_load(&next)) { atomic_store(&next, now + 1000000000ull); atomic_store(&par, access("/Library/NullMoth/detile-parallel", F_OK) == 0); }
+    return atomic_load(&par) ? 0 : t;
+}
+static void nvmtl_dapply_wrap(size_t n, dispatch_queue_t q, void (^blk)(size_t)) {
+    const int t = nvmtl_detile_threads();
+    atomic_fetch_add(&g_detile_calls, 1);
+    if (!t || !blk) { g_nvmtl_dapply_real(n, q, blk); return; }
+    if (t == 1 || n < 2) { for (size_t i = 0; i < n; i++) blk(i); return; }
+    const size_t tt = (size_t)t < n ? (size_t)t : n;
+    g_nvmtl_dapply_real(tt, q, ^(size_t k) { for (size_t i = k * n / tt; i < (k + 1) * n / tt; i++) blk(i); });
+}
+static int nvmtl_got_swap(const void *inImage, void *real, void *wrap) {
+    Dl_info di;
+    if (!real || !dladdr(inImage, &di) || !di.dli_fbase) return -1;
+    const struct mach_header_64 *mh = (const struct mach_header_64 *)di.dli_fbase;
+    if (mh->magic != MH_MAGIC_64) return -1;
+    const uint8_t *lc = (const uint8_t *)(mh + 1), *p = lc; intptr_t slide = 0; int haveSlide = 0, n = 0;
+    for (uint32_t i = 0; i < mh->ncmds; i++) {
+        const struct load_command *c = (const struct load_command *)p;
+        if (c->cmd == LC_SEGMENT_64) { const struct segment_command_64 *sg = (const struct segment_command_64 *)p;
+            if (!strncmp(sg->segname, "__TEXT", 16)) { slide = (intptr_t)mh - (intptr_t)sg->vmaddr; haveSlide = 1; } }
+        p += c->cmdsize;
+    }
+    if (!haveSlide) return -1;
+    p = lc;
+    for (uint32_t i = 0; i < mh->ncmds; i++) {
+        const struct load_command *c = (const struct load_command *)p;
+        if (c->cmd == LC_SEGMENT_64) {
+            const struct segment_command_64 *sg = (const struct segment_command_64 *)p;
+            const struct section_64 *sc = (const struct section_64 *)(sg + 1);
+            for (uint32_t k = 0; k < sg->nsects; k++) {
+                if (strncmp(sc[k].sectname, "__got", 16) && strncmp(sc[k].sectname, "__auth_got", 16) && strncmp(sc[k].sectname, "__la_symbol_ptr", 16)) continue;
+                void **slot = (void **)(uintptr_t)((intptr_t)sc[k].addr + slide);
+                const size_t cnt = (size_t)(sc[k].size / sizeof(void *));
+                for (size_t j = 0; j < cnt; j++) if (slot[j] == real) {
+                    const uintptr_t pg = (uintptr_t)&slot[j] & ~(uintptr_t)(getpagesize() - 1);
+                    if (mprotect((void *)pg, (size_t)getpagesize(), PROT_READ | PROT_WRITE)) return -2;
+                    slot[j] = wrap; n++;
+                    mprotect((void *)pg, (size_t)getpagesize(), PROT_READ);
+                }
+            }
+        }
+        p += c->cmdsize;
+    }
+    return n;
+}
+static void nvmtl_nvdec_hook_detile(const void *inImage) {
+    void *real = dlsym(RTLD_DEFAULT, "dispatch_apply");
+    if (!real) return;
+    g_nvmtl_dapply_real = (nvmtl_dapply_fn)real;
+    const int n = nvmtl_got_swap(inImage, real, (void *)nvmtl_dapply_wrap);
+    nvlog("detile1: libnvdec_hevc dispatch_apply wrapped at %d slot(s), %d thread(s) per picture", n, nvmtl_detile_threads());
+}
+// y540 ws46 spinwait: libnvdec waits for NVDEC to finish a picture by reading the completion semaphore in a tight loop
+// that calls clock_gettime(CLOCK_MONOTONIC) for its timeout, so a decoder thread ran flat out for the whole decode (about a
+// third of a core while QuickTime Player plays 4K H.264). The library's clock_gettime slot is wrapped: a call that comes
+// within 20 us of the same thread's previous one (the polling loop) first sleeps 100 us. Isolated calls (its statistics)
+// are untouched. /Library/NullMoth/spinwait-off switches it off.
+typedef int (*nvmtl_cgt_fn)(clockid_t, struct timespec *);
+static nvmtl_cgt_fn g_nvmtl_cgt_real;
+static __thread uint64_t t_nvmtl_cgt_last;
+static _Atomic unsigned long long g_nvmtl_spin_naps;
+static int nvmtl_spinwait_on(void) {
+    static _Atomic uint64_t next; static _Atomic int on = 1;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= atomic_load(&next)) { atomic_store(&next, now + 1000000000ull); atomic_store(&on, access("/Library/NullMoth/spinwait-off", F_OK) != 0); }
+    return atomic_load(&on);
+}
+static int nvmtl_cgt_wrap(clockid_t id, struct timespec *ts) {
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (t_nvmtl_cgt_last && now - t_nvmtl_cgt_last < 20000 && nvmtl_spinwait_on()) {
+        struct timespec d = { 0, 100000 }; nanosleep(&d, NULL); atomic_fetch_add(&g_nvmtl_spin_naps, 1);
+    }
+    const int r = g_nvmtl_cgt_real(id, ts);
+    t_nvmtl_cgt_last = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    return r;
+}
+// y540 ws47 devnull: libnvdec opens /dev/null read-write as a placeholder descriptor for its device handles. Safari's GPU
+// process sandbox allows no /dev file but /dev/random, read-only, so both NVDEC decoders refused every session there and
+// WebKit fell back to Apple's software decoders (4K H.264 in Safari: about 6 decoded frames a second, the rest dropped).
+// The libraries' open() slot is wrapped: when /dev/null is refused, /dev/random is opened read-only instead.
+typedef int (*nvmtl_open_fn)(const char *, int, ...);
+static nvmtl_open_fn g_nvmtl_open_real;
+static int nvmtl_open_wrap(const char *path, int flags, ...) {
+    int mode = 0;
+    if (flags & O_CREAT) { va_list ap; va_start(ap, flags); mode = va_arg(ap, int); va_end(ap); }
+    int fd = g_nvmtl_open_real(path, flags, mode);
+    if (fd < 0 && path && !strcmp(path, "/dev/null")) {
+        const int e = errno;
+        fd = g_nvmtl_open_real("/dev/random", (flags & ~O_ACCMODE) | O_RDONLY, 0);
+        static _Atomic int said; if (!atomic_exchange(&said, 1)) syslog(LOG_NOTICE, "NullMoth-y540: devnull: /dev/null refused (%d) in %s - /dev/random read-only -> %d", e, getprogname(), fd);
+        if (fd < 0) errno = e;
+    }
+    return fd;
+}
+static void nvmtl_nvdec_hook_spin(const void *inImage, const char *what) {
+    void *real = dlsym(RTLD_DEFAULT, "clock_gettime");
+    if (!real) return;
+    g_nvmtl_cgt_real = (nvmtl_cgt_fn)real;
+    const int n = nvmtl_got_swap(inImage, real, (void *)nvmtl_cgt_wrap);
+    void *ro = dlsym(RTLD_DEFAULT, "open");
+    if (ro) { if (!g_nvmtl_open_real) g_nvmtl_open_real = (nvmtl_open_fn)ro; }
+    const int no = ro ? nvmtl_got_swap(inImage, ro, (void *)nvmtl_open_wrap) : -1;
+    nvlog("spinwait: %s clock_gettime wrapped at %d slot(s), open at %d", what, n, no);
+}
+static void nvmtl_nvdec_hook_emit(const void *inImage) {
+    Dl_info di;
+    if (!dladdr(inImage, &di) || !di.dli_fbase) { nvlog("vidtime: dladdr failed"); return; }
+    void *real = dlsym(RTLD_DEFAULT, "VTDecoderSessionEmitDecodedFrame");
+    if (!real) { nvlog("vidtime: VTDecoderSessionEmitDecodedFrame not found"); return; }
+    const struct mach_header_64 *mh = (const struct mach_header_64 *)di.dli_fbase;
+    if (mh->magic != MH_MAGIC_64) return;
+    const uint8_t *lc = (const uint8_t *)(mh + 1), *p = lc; intptr_t slide = 0; int haveSlide = 0, n = 0;
+    for (uint32_t i = 0; i < mh->ncmds; i++) {
+        const struct load_command *c = (const struct load_command *)p;
+        if (c->cmd == LC_SEGMENT_64) { const struct segment_command_64 *sg = (const struct segment_command_64 *)p;
+            if (!strncmp(sg->segname, "__TEXT", 16)) { slide = (intptr_t)mh - (intptr_t)sg->vmaddr; haveSlide = 1; } }
+        p += c->cmdsize;
+    }
+    if (!haveSlide) return;
+    p = lc;
+    for (uint32_t i = 0; i < mh->ncmds; i++) {
+        const struct load_command *c = (const struct load_command *)p;
+        if (c->cmd == LC_SEGMENT_64) {
+            const struct segment_command_64 *sg = (const struct segment_command_64 *)p;
+            const struct section_64 *sc = (const struct section_64 *)(sg + 1);
+            for (uint32_t k = 0; k < sg->nsects; k++) {
+                if (strncmp(sc[k].sectname, "__got", 16) && strncmp(sc[k].sectname, "__auth_got", 16)) continue;
+                void **slot = (void **)(uintptr_t)((intptr_t)sc[k].addr + slide);
+                const size_t cnt = (size_t)(sc[k].size / sizeof(void *));
+                for (size_t j = 0; j < cnt; j++) if (slot[j] == real) {
+                    const uintptr_t pg = (uintptr_t)&slot[j] & ~(uintptr_t)(getpagesize() - 1);
+                    if (mprotect((void *)pg, (size_t)getpagesize(), PROT_READ | PROT_WRITE)) { nvlog("vidtime: mprotect RW refused"); return; }
+                    g_nvmtl_emit_real = (nvmtl_emit_fn)real; slot[j] = (void *)nvmtl_emit_wrap; n++;
+                    mprotect((void *)pg, (size_t)getpagesize(), PROT_READ);
+                }
+            }
+        }
+        p += c->cmdsize;
+    }
+    nvlog("vidtime: libnvdec_hevc frame output wrapped at %d slot(s)", n);
+}
+// y540 ws40 nvdec diag: NVMTL_NVDEC_DIAG=1 (nvrm610.conf) makes the HEVC decoder say why it takes or refuses a session.
+// It turns on libnvdec's own NVDEC_VT_VERBOSE/NVD265_VERBOSE, and where stderr is /dev/null (NeptuneOneWallpaper,
+// VTDecoderXPCService) routes fd 2 through a pipe into syslog. Every CreateInstance is logged with NVDecHEVC_Diag()
+// (sessions started, pictures emitted, errors, first failure) and nvd265_last_error(); notify com.nullmoth.nvdecdiag
+// logs the same line on demand.
+static int nvmtl_nvdec_diag_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_NVDEC_DIAG"); on = (e && *e && *e != '0') ? 1 : 0; }
+    return on;
+}
+static const char *(*g_nvdec_hevc_diag)(void);
+static const char *(*g_nvdec_hevc_lasterr)(void);
+typedef int32_t (*nvmtl_vdfac_fn)(uint32_t, CFAllocatorRef, void **);
+static nvmtl_vdfac_fn g_nvdec_hevc_fac;
+static _Atomic unsigned g_nvdec_hevc_creates;
+static void nvmtl_nvdec_diag_line(const char *why) {
+    syslog(LOG_NOTICE, "NullMoth-y540: nvdec-diag %s in %s: creates %u | %s | last error [%s]", why, getprogname(),
+           atomic_load(&g_nvdec_hevc_creates), g_nvdec_hevc_diag ? g_nvdec_hevc_diag() : "?",
+           g_nvdec_hevc_lasterr ? g_nvdec_hevc_lasterr() : "?");
+}
+static int32_t nvmtl_nvdec_hevc_fac_wrap(uint32_t codec, CFAllocatorRef al, void **out) {
+    int32_t st = g_nvdec_hevc_fac(codec, al, out);
+    atomic_fetch_add(&g_nvdec_hevc_creates, 1);
+    char why[48]; snprintf(why, sizeof why, "CreateInstance -> %d", (int)st);
+    nvmtl_nvdec_diag_line(why);
+    return st;
+}
+static void *nvmtl_stderr_pump(void *arg) {
+    FILE *f = fdopen((int)(intptr_t)arg, "r");
+    if (!f) return NULL;
+    char line[1024];
+    while (fgets(line, sizeof line, f)) {
+        size_t n = strlen(line); if (n && line[n - 1] == '\n') line[n - 1] = 0;
+        if (strstr(line, "nvd")) syslog(LOG_NOTICE, "NullMoth-y540: stderr %s", line);
+    }
+    fclose(f);
+    return NULL;
+}
+static void nvmtl_stderr_into_log(void) {
+    const char *me = getprogname(), *e = getenv("NVMTL_NVDEC_DIAG");
+    if (strcmp(me, "NeptuneOneWallpaper") && strcmp(me, "VTDecoderXPCService") && !(e && *e == '2')) return;
+    struct stat a, b;
+    if (fstat(2, &a) || stat("/dev/null", &b) || !S_ISCHR(a.st_mode) || a.st_rdev != b.st_rdev) return;
+    int p[2]; if (pipe(p)) return;
+    fcntl(p[1], F_SETFL, fcntl(p[1], F_GETFL) | O_NONBLOCK);   // a stalled pump drops lines; the writer never blocks
+    if (dup2(p[1], 2) < 0) { close(p[0]); close(p[1]); return; }
+    close(p[1]);
+    setvbuf(stderr, NULL, _IOLBF, 0);
+    pthread_t th; pthread_attr_t at; pthread_attr_init(&at); pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&th, &at, nvmtl_stderr_pump, (void *)(intptr_t)p[0])) { close(p[0]); }
+    pthread_attr_destroy(&at);
+}
