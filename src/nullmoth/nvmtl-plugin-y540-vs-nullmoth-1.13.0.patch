-    struct nvmtl_cxx_string name;
-    nvmtl_cxx_string(&name, "nvmtl");
-    void *cgs = Create(&name);
-    if (!cgs) { nvlog("vendor compiler: MTLCodeGenServiceCreate returned nil"); return false; }
