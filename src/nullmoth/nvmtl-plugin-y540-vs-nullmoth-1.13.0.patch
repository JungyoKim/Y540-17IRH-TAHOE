+// ---- y540 ws24: VRAM reuse for Core Animation's per-frame textures ------------------------------------------------------
+// A Mission Control frame spent about 30% of WindowServer's main thread in RM ioctls: Core Animation makes its scratch
+// textures (blur mip chains, flatten and backdrop surfaces) with newTextureWithDescriptor: every frame, and wraps the
+// IOSurfaces of its flatten cache in a new MTLTexture every frame. Each scratch texture cost an RM allocation, a VA map
+// and a bind; each wrap re-imported the surface's VRAM (open, RM import, VA map). Both are now kept for a short time.
+static uint64_t nvmtl_pool_now(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+static _Atomic unsigned long long g_set_recycled;   // nvmtl_vk.c (ws25 setpool)
+static _Atomic unsigned long long g_pipe_skips;     // nvmtl_vk.c (ws27 pipeskip)
