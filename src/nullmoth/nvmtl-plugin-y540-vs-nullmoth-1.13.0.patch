+    nvmtl_upload_record(p->cb.cb, src, img);
+    p->n++; p->copies++; p->bytes += (size_t)img->w * img->h * (img->bpp ? img->bpp : 4);
+    return 0;
+}
+int nvmtl_vk_image_upload_sync(nvk_queue *q, nvk_buffer *src, nvk_image *img)
+{
+    if (!nvmtl_upload_fits(src, img)) return -1;
+    nvk_cmdbuf c; if (nvmtl_vk_cmd_begin(q, &c)) return -1;
+    nvmtl_upload_record(c.cb, src, img);
+    img->layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    return nvmtl_vk_submit_wait(&c);
+}
+// y540 ws31 sdirect: the same upload from a pitched source (an IOSurface's own pages imported once as a host-pointer
+// buffer), so no CPU copy into a packed stage is needed. off and the row pitch are in bytes of the source buffer.
+static int nvmtl_upload_fits_pitched(nvk_buffer *src, size_t off, uint32_t rowTexels, nvk_image *img)
+{
+    const size_t bpp = img && img->bpp ? img->bpp : 4;
+    return src && src->buf && img && img->img && img->bw <= 1 && img->bh <= 1 && rowTexels >= img->w && img->h
+        && off % bpp == 0 && off + ((size_t)img->h - 1) * rowTexels * bpp + (size_t)img->w * bpp <= src->size;
+}
+static void nvmtl_upload_record_pitched(VkCommandBuffer cb, nvk_buffer *src, size_t off, uint32_t rowTexels, nvk_image *img)
+{
+    VkImageSubresourceRange range = { nvmtl_barrier_aspect(img), 0, 1, 0, 1 };
+    VkImageMemoryBarrier toDst = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_MEMORY_READ_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &toDst);
+    VkBufferImageCopy bic = { (VkDeviceSize)off, rowTexels, 0, { nvmtl_copy_aspect(img), 0, 0, 1 }, { 0, 0, 0 }, { img->w, img->h, 1 } };
+    pvkCmdCopyBufferToImage(cb, (VkBuffer)src->buf, (VkImage)img->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bic);
+    VkImageMemoryBarrier toRead = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_MEMORY_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &toRead);
+}
+int nvmtl_vk_pre_image_upload_pitched(nvk_buffer *src, size_t off, uint32_t rowTexels, nvk_image *img)
+{
+    nvmtl_prologue *p = g_pre_cur;
+    if (!p || !p->begun || !nvmtl_upload_fits_pitched(src, off, rowTexels, img)) return -1;
+    nvmtl_upload_record_pitched(p->cb.cb, src, off, rowTexels, img);
+    p->n++; p->copies++; p->bytes += (size_t)img->w * img->h * (img->bpp ? img->bpp : 4);
+    return 0;
+}
+int nvmtl_vk_image_upload_pitched_sync(nvk_queue *q, nvk_buffer *src, size_t off, uint32_t rowTexels, nvk_image *img)
+{
+    if (!nvmtl_upload_fits_pitched(src, off, rowTexels, img)) return -1;
+    nvk_cmdbuf c; if (nvmtl_vk_cmd_begin(q, &c)) return -1;
+    nvmtl_upload_record_pitched(c.cb, src, off, rowTexels, img);
+    img->layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    return nvmtl_vk_submit_wait(&c);
+}
+// y540 ws48 band: rows [y, y+h) of a pitched upload as their own submission. The first band (y == 0) may discard the old
+// contents like the whole-image upload; later bands keep the rows already written.
+int nvmtl_vk_image_upload_pitched_band_sync(nvk_queue *q, nvk_buffer *src, size_t off, uint32_t rowTexels, nvk_image *img, uint32_t y, uint32_t h)
+{
+    if (!nvmtl_upload_fits_pitched(src, off, rowTexels, img) || !h || y >= img->h || h > img->h - y) return -1;
+    const size_t bpp = img->bpp ? img->bpp : 4;
+    nvk_cmdbuf c; if (nvmtl_vk_cmd_begin(q, &c)) return -1;
+    VkImageSubresourceRange range = { nvmtl_barrier_aspect(img), 0, 1, 0, 1 };
+    VkImageMemoryBarrier toDst = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, y ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(c.cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &toDst);
+    VkBufferImageCopy bic = { (VkDeviceSize)(off + (size_t)y * rowTexels * bpp), rowTexels, 0, { nvmtl_copy_aspect(img), 0, 0, 1 },
+                              { 0, (int32_t)y, 0 }, { img->w, h, 1 } };
+    pvkCmdCopyBufferToImage(c.cb, (VkBuffer)src->buf, (VkImage)img->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bic);
+    VkImageMemoryBarrier toRead = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_MEMORY_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(c.cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &toRead);
+    img->layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    return nvmtl_vk_submit_wait(&c);
+}
+size_t nvmtl_vk_host_align(void) { return g_host_import ? g_host_align : 0; }
+void nvmtl_vk_image_mark_sampled(nvk_image *img) { if (img) img->layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL; }
+int nvmtl_vk_prologue_enabled(void) { return nvmtl_prologue_on(); }
 
