+    uint32_t m; memcpy(&m, f.bytes, 4); if (m != NVMTL_SPVZ_MAGIC) return f;
+    *packed = 1;
+    uint64_t raw; memcpy(&raw, (const uint8_t *)f.bytes + 4, 8);
+    if (!raw || raw > (256ull << 20)) return nil;
+    NSMutableData *o = [NSMutableData dataWithLength:(NSUInteger)raw];
+    const size_t got = compression_decode_buffer(o.mutableBytes, (size_t)raw, (const uint8_t *)f.bytes + 12, f.length - 12, NULL, COMPRESSION_LZFSE);
+    return got == raw ? o : nil;
