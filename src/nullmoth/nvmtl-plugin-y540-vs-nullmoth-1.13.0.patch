+    notify_register_dispatch("com.nullmoth.nvdecdiag", &tok, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0),
+                             ^(int t) { (void)t; nvmtl_nvdec_diag_line("on demand"); });
