+@interface NVMTLComputeVariant : NSObject {
+  @public
+    NSData  *_cubin;
+    NSData  *_ptx;
+    const uint8_t *_text;
+    uint32_t _textLen, _regs, _smem, _barriers, _nparams;
+    NSString *_name;
+}
+@end
