+struct nvmtl_cxx_string { char raw[24]; };
+static void nvmtl_cxx_string(struct nvmtl_cxx_string *s, const char *text) {
+    size_t n = strlen(text);
+    memset(s, 0, sizeof *s);
+    if (n > 22) n = 22;
+    memcpy(s->raw, text, n);
+    s->raw[23] = (char)(n & 0x7f);
+}
